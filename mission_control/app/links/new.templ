// Package links is Add project: link a
// repo, check access with its deploy key, read its compose file, and save.
package links

import (
	"sort"
	"strconv"
	"strings"

	"github.com/scttymn/houston/internal/mission"
	"github.com/scttymn/houston/mission_control/app/models"
	"github.com/scttymn/houston/mission_control/app/shared/layout"
)

// Page is what Add project shows.
type Page struct {
	Layout       layout.Page
	Base         string
	Link         *models.RepoLink
	Found        *mission.Inspection
	EnteredURL   string
	URLError     string
	Access       *access
	BranchError  string
	PathError    string
	Problems     string
	SaveError    string
	SecretErrors map[string]string
	Existing     *models.Project // a project of the name read, already there
}

type access struct {
	OK      bool
	Message string
}

templ NewPage(pg Page) {
	@layout.Layout(pg.Layout) {
		<main class="page link">
			<div class="link-intro">
				<nav class="mono crumbs"><a href="/">Projects</a> <span>/</span> <span class="crumbs__here">Add project</span></nav>
				<h1 class="disp">Add project</h1>
				<p>Link a repo. Mission Control reads its compose.yml, takes its secrets, and gives you a webhook so every push reaches Houston.</p>
			</div>
			<div class="link-grid">
				<section class="panel link-step link-repo">
					<div class="panel__head"><h2 class="disp panel__title"><span class="mono step-number">01</span> Link the repo</h2></div>
					<div class="link-repo__body">
						<form class="field" data-turbo="false" action="/link/access" method="post">
							<label for="repo_url">Repo URL</label>
							<span class="field__with-button">
								<input value={ repoURL(pg) } class="mono" placeholder="git@github.com:you/app.git" autocomplete="off" aria-invalid?={ pg.URLError != "" } type="text" name="repo_url" id="repo_url"/>
								<input type="submit" name="commit" value="Check access" class="button button--medium"/>
							</span>
							<span class="field__hint">Any git host. SSH or HTTPS URL.</span>
							if pg.URLError != "" {
								<span class="field__error">{ "The repo URL " + pg.URLError }</span>
							}
						</form>
						if l := pg.Link; l != nil {
							<div class="key-box" data-controller="clipboard">
								<span class="mono eyebrow">READ ACCESS · DEPLOY KEY</span>
								<span>Add this key to the repo as a read-only deploy key. Public repos can skip it.</span>
								<pre class="mono deploy-key" data-clipboard-target="source">{ l.DeployKeyPublic }</pre>
								<button type="button" class="button button--small" data-action="clipboard#copy" data-clipboard-target="button">Copy key</button>
								if a := pg.Access; a != nil {
									<p class="check">
										if a.OK {
											<span class="mono check__state check__state--go">GO</span>
										} else {
											<span class="mono check__state check__state--nogo">NO-GO</span>
										}
										<span>{ a.Message }</span>
									</p>
								}
							</div>
							<form class="link-read" data-turbo="false" action="/link/read" method="post">
								<div class="field-pair">
									<div class="field">
										<label for="branch">Branch to read</label>
										<input value={ l.Branch } class="mono" type="text" name="branch" id="branch"/>
										if pg.BranchError != "" {
											<span class="field__error">{ "The branch " + pg.BranchError }</span>
										}
									</div>
									<div class="field">
										<label for="compose_path">Config path</label>
										<input value={ l.ComposePath } class="mono" type="text" name="compose_path" id="compose_path"/>
										if pg.PathError != "" {
											<span class="field__error">{ "The config path " + pg.PathError }</span>
										}
									</div>
								</div>
								<input type="submit" name="commit" value="Read compose.yml" class="button button--medium link-read__button"/>
							</form>
							if pg.Problems != "" {
								<div class="problems"><span class="mono check__state--nogo">NO-GO</span><pre class="mono">{ pg.Problems }</pre></div>
							}
						}
						<p class="panel__row--muted link-hint"><span>No x-houston block yet? Run <span class="mono code-chip">houston init</span> in the repo and push it first.</span></p>
					</div>
				</section>
				<div class="link-side">
					if pg.SaveError != "" {
						<div class="notice notice--nogo"><span class="mono">NO-GO</span><span class="notice__text">{ pg.SaveError }</span></div>
					}
					if f := pg.Found; f != nil {
						@found(pg, *f)
					} else {
						<section class="panel link-waiting">
							<p class="panel__row panel__row--muted">Read compose.yml to see what Houston found: the name and domains, the services, and the secrets to set before the first deploy.</p>
						</section>
					}
					if pg.Link != nil {
						// Cancel sits with Save, but forms can't nest: its button names this one.
						<form id="link-cancel" action="/link" method="post"><input type="hidden" name="_method" value="delete" autocomplete="off"/></form>
						<form class="link-finish" action="/link" method="post">
							if f := pg.Found; f != nil {
								@secrets(pg, *f)
								@webhook(pg, *f)
							}
							if e := pg.Existing; e != nil {
								<div class="notice notice--hold link-existing">
									<span class="mono">UPDATE</span>
									<span class="notice__text"><a href={ templ.SafeURL("/projects/" + e.Name) }>{ e.Name }</a> is already a project. Save updates it: this branch, config path and deploy key replace the current ones. Its subdomains and webhook stay as they are.</span>
								</div>
							}
							<div class="link-save">
								<span class="muted link-save__note">
									if pg.Found != nil {
										Required secrets left blank hold deploys until they have a value.
									} else {
										Save needs what Houston read from the repo.
									}
								</span>
								<div class="link-save__actions">
									<button type="submit" form="link-cancel" class="button button--medium button--quiet">Cancel</button>
									<button name="button" type="submit" class="button button--medium" disabled?={ pg.Found == nil }>Save</button>
									<button name="deploy" type="submit" value="1" class="button button--medium button--primary" disabled?={ pg.Found == nil }>Deploy</button>
								</div>
							</div>
						</form>
					}
				</div>
			</div>
		</main>
	}
}

templ found(pg Page, f mission.Inspection) {
	{{ sync, pv := f.Sync, f.Preview }}
	<section class="panel found">
		<div class="panel__head"><h2 class="disp panel__title"><span class="mono step-number">02</span> What Houston found</h2><span class="mono panel__meta muted">{ pg.Link.Branch + " @ " + pg.Link.PreviewSha[:min(7, len(pg.Link.PreviewSha))] }</span></div>
		<dl class="plan">
			<dt class="mono">NAME</dt><dd><span class="mono">{ sync.Name }</span>{ " → " + sync.Name + "." + pg.Base }</dd>
			<dt class="mono">DOMAINS</dt>
			<dd class="plan__list">
				for _, domain := range append([]string{sync.Name + "." + pg.Base}, sync.Domains...) {
					<span>{ domain }</span>
				}
			</dd>
			<dt class="mono">APP</dt><dd>{ appWords(pv) }</dd>
			<dt class="mono">SERVICES</dt><dd>{ servicesWords(pv) }</dd>
			<dt class="mono">DEPLOYS</dt><dd>{ deploysWords(sync, pv) }</dd>
			<dt class="mono">BACKUPS</dt><dd>{ backupsWords(pv.Backups) }</dd>
		</dl>
	</section>
}

templ secrets(pg Page, f mission.Inspection) {
	<section class="panel link-secrets">
		<div class="panel__head"><h2 class="disp panel__title"><span class="mono step-number">03</span> Secrets</h2><span class="panel__meta muted">Set now so the first deploy doesn't stop</span></div>
		if len(f.Sync.Variables) == 0 {
			<p class="panel__row panel__row--muted">compose.yml references no variables.</p>
		}
		for _, v := range sortedVariables(f.Sync.Variables) {
			<div class="link-secret" data-secret={ v.Name }>
				<label class="mono" for={ "secret_" + v.Name }>{ v.Name }</label>
				<span class="mono link-secret__source">COMPOSE.YML</span>
				<input type="password" name={ "secrets[" + v.Name + "]" } id={ "secret_" + v.Name } class="mono" autocomplete="off" placeholder={ requiredWord(v.Required) }/>
				if problem := pg.SecretErrors[v.Name]; problem != "" {
					<span class="field__error">{ v.Name + " " + problem }</span>
				}
			</div>
		}
	</section>
}

templ webhook(pg Page, f mission.Inspection) {
	<section class="panel link-webhook" data-controller="clipboard">
		<div class="panel__head"><h2 class="disp panel__title"><span class="mono step-number">04</span> Connect pushes</h2><span class="panel__meta muted">In the repo's webhook settings</span></div>
		<div class="link-webhook__body">
			<p>Your git host calls this address every time you push. Houston checks the secret, reads the repo's refs itself, and deploys the commit when it matches the deploy rule. Paste both into the repo's webhook settings (GitHub calls the URL "Payload URL").</p>
			<div class="copy-row"><span class="mono eyebrow">WEBHOOK URL</span><span class="mono copy-row__value">{ "https://hooks." + pg.Base + "/" + f.Sync.Name }</span></div>
			if e := pg.Existing; e != nil && e.WebhookVerifiedAt.Valid {
				<p>Pushes already arrive with this project's secret, so it isn't shown again. Rotate it on the project page to get a new one.</p>
			} else {
				<div class="copy-row"><span class="mono eyebrow">SECRET</span><span class="mono copy-row__value copy-row__value--dark" data-webhook-secret data-clipboard-target="source">{ webhookSecret(pg) }</span><button type="button" class="button button--small" data-action="clipboard#copy" data-clipboard-target="button">Copy</button></div>
				<div class="copy-row"><span class="mono eyebrow">SEND</span><span>Push events, as <span class="mono">application/json</span></span></div>
				<p class="link-webhook__waiting">Waiting for the first push. The secret is shown in full only until one arrives.</p>
			}
		</div>
	</section>
}

func repoURL(pg Page) string {
	if pg.EnteredURL != "" || pg.Link == nil {
		return pg.EnteredURL
	}
	return pg.Link.RepoUrl
}

func appWords(pv mission.Preview) string {
	app := []string{"Port " + strconv.Itoa(pv.Port), "health " + pv.Health}
	if pv.CPUs != "" {
		unit := "CPUs"
		if pv.CPUs == "1" {
			unit = "CPU"
		}
		app = append(app, pv.CPUs+" "+unit)
	}
	if pv.Memory != "" {
		app = append(app, pv.Memory)
	}
	return strings.Join(app, " · ")
}

func servicesWords(pv mission.Preview) string {
	var out []string
	for _, s := range pv.Services {
		if !s.App {
			out = append(out, s.Name+" · "+s.Image)
		}
	}
	if len(out) == 0 {
		return "none besides the app"
	}
	return strings.Join(out, ", ")
}

func deploysWords(sync mission.SyncRequest, pv mission.Preview) string {
	rule := sync.DeployRule
	words := "Every commit to " + rule.Branch
	if rule.On == "tag" {
		words = "Tags matching " + rule.Tags
	}
	if pv.Test {
		words += " · tests run first"
	}
	return words
}

func backupsWords(b mission.PreviewBackups) string {
	words := b.Schedule + " · keep " + strconv.Itoa(b.KeepAuto) + " auto, " + strconv.Itoa(b.KeepDeploy) + " deploy"
	if len(b.Volumes) > 0 {
		words += " · volumes " + strings.Join(b.Volumes, ", ")
	}
	return words
}

// sortedVariables are the required first, then by name.
func sortedVariables(vars []mission.Variable) []mission.Variable {
	out := append([]mission.Variable(nil), vars...)
	sort.SliceStable(out, func(i, j int) bool {
		if out[i].Required != out[j].Required {
			return out[i].Required
		}
		return out[i].Name < out[j].Name
	})
	return out
}

func requiredWord(required bool) string {
	if required {
		return "Required"
	}
	return "Optional"
}

// webhookSecret is the project's own when it's linked again (its repo's
// webhook keeps working), else the draft's.
func webhookSecret(pg Page) string {
	if e := pg.Existing; e != nil && e.WebhookSecret.Reveal() != "" {
		return e.WebhookSecret.Reveal()
	}
	return pg.Link.WebhookSecret.Reveal()
}
