<% content_for :title, "Settings · Mission Control" %>
<% base = @installation.base_domain %>
<%# One page, as the design's Settings: the menu on the left, the sections in one column. %>
<main class="settings">
  <%= render "settings/nav" %>
  <div class="settings__body">
    <% if notice %><div class="notice notice--go"><span class="mono">OK</span><span class="notice__text"><%= notice %></span></div><% end %>
    <% if alert %><div class="notice notice--nogo"><span class="mono">NO-GO</span><span class="notice__text"><%= alert %></span></div><% end %>
    <section class="settings-section" id="tokens">
      <div class="panel__head"><h2 class="disp panel__title">API tokens</h2></div>
    <% if @new_token %>
      <div class="new-token-box" data-controller="clipboard">
        <div class="panel__head"><h2 class="disp panel__title">Token "<%= @created_name %>"</h2><span class="mono panel__meta eyebrow eyebrow--signal">SHOWN ONCE</span></div>
        <p class="panel__row">Copy it now: Houston shows it only this once.</p>
        <pre class="mono deploy-key new-token" data-clipboard-target="source"><%= @new_token %></pre>
        <p class="panel__row">
          <button type="button" class="button button--small" data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
          <span class="mono">houston login https://admin.<%= Installation.current.base_domain %></span>, then paste it. Agents can set <span class="mono">HOUSTON_SERVER</span> and <span class="mono">HOUSTON_API_TOKEN</span> instead.
        </p>
      </div>
    <% end %>

      <p class="panel__row panel__row--muted">For the houston CLI with <span class="mono">--server</span>, and for agents. A token can see and change projects and write secrets; it can never read a secret's value.</p>
      <% if @tokens.empty? %><p class="panel__row panel__row--muted">No tokens yet.</p><% end %>
      <ul class="rows">
        <% @tokens.each do |token| %>
          <li data-token="<%= token.name %>" class="token-row">
            <span class="mono"><%= token.name %></span>
            <span>created <%= l(token.created_at.to_date, format: :short) %></span>
            <span><%= token.last_used_at ? "last used #{time_ago_in_words(token.last_used_at)} ago" : "never used" %></span>
            <%= button_to "Revoke", settings_token_path(token), method: :delete, class: "button button--small" %>
          </li>
        <% end %>
      </ul>
      <%= form_with url: settings_tokens_path, class: "panel__row inline-form token-new", data: { turbo: false } do |f| %>
        <%= f.text_field :name, placeholder: "Name, e.g. laptop or ci-agent", class: "mono", maxlength: 50, "aria-label": "Token name" %>
        <%= f.submit "New CLI token", class: "button button--primary button--small" %>
        <% if @token_error %><span class="field__error"><%= @token_error %></span><% end %>
      <% end %>
    </section>

    <section class="settings-section" id="cloudflare">
      <div class="panel__head"><h2 class="disp panel__title">Cloudflare</h2></div>
      <div class="settings-facts">
        <div><span class="mono facts-strip__label">BASE DOMAIN</span>
          <span><%= base.presence || "not set yet" %></span></div>
        <div><span class="mono facts-strip__label">DNS</span>
          <span><%= @installation.dns_mode == "per_host" ? "Host by host" : "Wildcard *.#{base}" %></span></div>
        <% tunnel = SystemStatus.tunnel(@installation) %>
        <div><span class="mono facts-strip__label">TUNNEL</span>
          <span><%= status_word(tunnel.go?) %><% if tunnel.connections.positive? %> <span class="mono muted">· <%= tunnel.connections %> CONN</span><% end %></span></div>
      </div>
      <% if @installation.tunnel_id.present? %>
        <turbo-frame id="cloudflare-live" src="<%= settings_cloudflare_path %>" loading="lazy">
          <p class="panel__row panel__row--muted">Asking Cloudflare for the tunnel, its routes and Houston's records…</p>
        </turbo-frame>

        <% if @repair_results %>
          <div class="cf-block">
            <span class="mono facts-strip__label">REPAIR</span>
            <ul class="rows cf-repair">
              <% @repair_results.each do |r| %>
                <li><span class="mono"><%= r.item %></span><span class="mono state state--<%= r.state.in?(%w[OK DNS\ OK]) ? "go" : "nogo" %>"><%= r.state %></span><span class="muted"><%= r.reason %></span></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="cf-actions">
          <%= form_with url: token_settings_cloudflare_path, method: :patch, class: "inline-form cf-token", data: { turbo: false } do |f| %>
            <%= f.label :api_token, "Replace the API token", class: "mono facts-strip__label" %>
            <%= f.password_field :api_token, autocomplete: "off", class: "mono", placeholder: "The new token's value" %>
            <%= f.submit "Check and replace", class: "button button--small" %>
          <% end %>
          <% if @token_checks %>
            <% @token_checks.each do |c| %>
              <p class="check"><span class="mono check__state check__state--<%= c.ok ? "go" : "nogo" %>"><%= c.ok ? "GO" : "NO-GO" %></span><span><%= c.label %></span></p>
            <% end %>
            <p class="muted">The old token is still in use.</p>
          <% end %>
          <%= button_to "Repair routes and records", repair_settings_cloudflare_path, class: "button button--small", form: { class: "cf-repair-form", data: { turbo: false } } %>
        </div>
      <% end %>
      <p class="panel__row panel__row--muted">The new token needs Account · Cloudflare Tunnel · Edit, and Zone · DNS · Edit on <%= base %> and on every project domain's zone. Houston only touches DNS records commented <span class="mono">managed-by:houston</span>.</p>
    </section>

    <section class="settings-section" id="port">
      <div class="panel__head"><h2 class="disp panel__title">Port 3000</h2></div>
      <% address = PortExposure.address %>
      <p class="panel__row">
        <% if address.nil? %>
          Houston can't tell what port 3000 is bound to right now (it asks Docker).
        <% elsif address == "127.0.0.1" %>
          <%= state_pill(:go, "CLOSED") %> only on this server (127.0.0.1). Reach it with <span class="mono">ssh -L 3000:127.0.0.1:3000</span>, then <span class="mono">http://localhost:3000</span>.
        <% elsif address == "0.0.0.0" %>
          <%= state_pill(:hold, "OPEN") %> to your network, over plain HTTP, at <span class="mono">http://&lt;server address&gt;:3000</span>.
        <% else %>
          <%= state_pill(:hold, "OPEN") %> on <span class="mono"><%= address %></span>, over plain HTTP (the installer's HOUSTON_BIND).
        <% end %>
      </p>
      <% unless address.nil? %>
        <%= form_with url: settings_port_path, method: :patch, class: "panel__row inline-form" do |f| %>
          <%= hidden_field_tag :open, address == "127.0.0.1" ? "1" : "0" %>
          <%= f.button address == "127.0.0.1" ? "Open port 3000 to the network" : "Close port 3000", class: "button button--small" %>
        <% end %>
      <% end %>
      <p class="panel__row panel__row--muted">Mission Control is always at <span class="mono">https://admin.<%= @installation.base_domain %></span>. Port 3000 is for first-run setup and your own network. On a server with a public address, close it: Docker publishes it straight past the server's firewall. Changing it restarts Mission Control for a few seconds. The installer keeps your choice.</p>
    </section>

    <section class="settings-section" id="storage">
      <div class="panel__head">
        <h2 class="disp panel__title">Storage locations</h2>
        <%= link_to "Add storage location", new_settings_storage_location_path, class: "button button--primary button--small" %>
      </div>
      <div class="mono storage-head"><span>NAME</span><span>TYPE</span><span>LOCATION</span><span>HOLDS</span><span>USED BY</span><span>LAST WRITE</span><span></span></div>
      <ul class="rows storage-rows">
        <% @locations.each do |location| %>
          <% used = location.projects_using %>
          <% last = location.last_write %>
          <li data-location="<%= location.name %>" class="storage-row">
            <span class="mono"><%= location.name %><% if location.default? %> <small class="mono badge">DEFAULT</small><% end %></span>
            <span class="mono"><%= location.kind %></span>
            <span class="mono"><%= location.where_it_is %></span>
            <span><%= location.holds_words %></span>
            <span><%= used.zero? ? "not used yet" : pluralize(used, "project") %></span>
            <span><%= last ? l(last, format: :short) : "—" %></span>
            <span>
              <% if !location.acknowledged? %>
                <%= link_to "Save its password", settings_storage_location_path(location.name) %>
              <% elsif !location.default? %>
                <%= button_to "Make default", default_settings_storage_location_path(location.name), class: "button button--small" %>
              <% end %>
            </span>
            <% if location.prune_error.present? %><small class="field__error">Last prune failed: <%= location.prune_error %></small><% end %>
          </li>
        <% end %>
      </ul>
      <p class="panel__row panel__row--muted">Where backups go, and where live volumes can live. Each location has its own restic password, shown once when it's added.</p>
    </section>

    <section class="settings-section" id="time-zone">
      <div class="panel__head"><h2 class="disp panel__title">Time zone</h2></div>
      <p class="panel__row">Backup schedules run in it: <span class="mono">daily 03:00</span> means 03:00 here.</p>
      <%= form_with url: settings_general_path, method: :patch, class: "panel__row inline-form" do |f| %>
        <%= f.select :time_zone, TZInfo::Timezone.all_identifiers, { selected: @installation.time_zone }, class: "mono", "aria-label": "Time zone" %>
        <%= f.submit "Save", class: "button button--small" %>
      <% end %>
      <% if @error %><p class="panel__row"><span class="field__error"><%= @error %></span></p><% end %>
    </section>
  </div>
</main>
