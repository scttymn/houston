<% content_for :title, "Deleting #{@deletion.name} · Mission Control" %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>
<% active = @deletion.active? %>
<main class="page deploy-page">
  <nav class="mono crumbs"><%= link_to "Projects", root_path %> <span>/</span>
    <% if @deletion.project %><%= link_to @deletion.name, project_path(@deletion.name) %><% else %><span><%= @deletion.name %></span><% end %>
    <span>/</span> <span class="crumbs__here">Delete</span></nav>

  <div class="deploy-status">
    <div class="deploy-head">
      <div class="deploy-head__main">
        <div class="deploy-head__title">
          <h1 class="disp">Deleting <%= @deletion.name %></h1>
          <%= active ? state_pill(:in_flight, "DELETING") : state_pill(@deletion.status == "go" ? :go : :no_go) %>
        </div>
        <p class="deploy-head__meta">Asked by <%= @deletion.by %> · <%= l(@deletion.created_at, format: :short) %><%= " · backups deleted too" if @deletion.delete_backups %></p>
      </div>
    </div>

    <% if active %>
      <div class="serving" data-controller="refresh" data-refresh-every-value="5000">
        <span class="serving__dot"></span>
        <span><%= @deletion.removing? ? "#{@deletion.name} is being taken apart; it serves nothing new meanwhile." : "#{@deletion.name} keeps serving until its final snapshot is taken." %></span>
      </div>
    <% elsif @deletion.status == "go" %>
      <div class="notice notice--go">
        <span class="mono">GO</span>
        <span class="notice__text">
          <%= @deletion.name %> was deleted.
          <% if @deletion.snapshot_id %>
            Its final snapshot <%= @deletion.snapshot_id.first(8) %> in <%= @deletion.snapshot_location&.name %> is kept<%= ", with its other backups" unless @deletion.delete_backups %>: add a project named <%= @deletion.name %> again, then <span class="mono">houston restore <%= @deletion.snapshot_id.first(8) %></span>.
          <% elsif @deletion.delete_backups %>
            Its backups were deleted too.
          <% end %>
        </span>
      </div>
    <% elsif @deletion.cancelled? %>
      <div class="notice notice--nogo"><span class="mono">NO-GO</span><span class="notice__text">Deleting <%= @deletion.name %> was <%= @deletion.error %>. Nothing was removed; it serves as before.</span></div>
    <% else %>
      <div class="notice notice--nogo">
        <span class="mono">NO-GO</span>
        <span class="notice__text">Deleting <%= @deletion.name %> <%= @deletion.error %>. It serves nothing new until it's finished.</span>
        <% if @deletion.project %>
          <%= button_to "Finish deleting", project_deletion_path(@deletion.name), params: { confirm: @deletion.name }, class: "button button--small" %>
        <% end %>
      </div>
    <% end %>
    <% if @deletion.status == "go" && @deletion.repo_url.present? %>
      <div class="notice notice--hold"><span class="mono">ON THE GIT HOST</span><span class="notice__text">Houston can't remove the deploy key and the webhook it gave <%= @deletion.repo_url %>; remove them there.</span></div>
    <% end %>
  </div>

  <div class="deploy-body">
    <ol class="panel deploy-steps">
      <% @deletion.steps.each_with_index do |(words, state), i| %>
        <li data-state="<%= state %>">
          <span class="mono"><%= format("%02d", i) %></span>
          <span><%= words %></span>
          <span class="mono step__state"><%= { done: "DONE", current: "RUNNING", failed: "FAILED", pending: "" }.fetch(state) %></span>
        </li>
      <% end %>
    </ol>
    <section class="log-panel" data-controller="follow clipboard">
      <div class="log-panel__head">
        <% if active %><span class="mono log-panel__live">LIVE</span><% end %>
        <span class="mono log-panel__what">houston · delete <%= @deletion.name %></span>
        <span class="log-panel__spacer"></span>
        <label class="mono"><input type="checkbox" checked data-follow-target="toggle" data-action="change->follow#toggle"> Follow</label>
        <button type="button" class="mono log-panel__copy" data-action="clipboard#copy" data-clipboard-target="button">Copy log</button>
      </div>
      <pre class="mono log" data-follow-target="log" data-clipboard-target="source" data-action="scroll->follow#scrolled"><%= @deletion.log.presence || "Waiting to start…" %></pre>
    </section>
  </div>
  <%= render "shared/toast" %>
</main>
