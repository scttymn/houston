<%# A project's hostnames, each with its DNS state (the flight board's row and phone card). %>
<% project.hostnames(@installation).each do |host| %>
  <% state = project.domain_states.dig(host, "state") %>
  <%= link_to app_url(host), target: "_blank", rel: "noopener noreferrer", class: "flight__host host-chip--#{state.to_s.parameterize.presence || "ok"}" do %>
    <span class="flight__dot"></span><span class="flight__hostname"><%= host %></span>
    <% if state && state != "DNS OK" %><small class="mono domain-state domain-state--<%= state.parameterize %>" title="<%= project.domain_states.dig(host, "reason") %>"><%= state %></small><% end %>
    <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4.5 2H10v5.5M10 2L2.5 9.5" stroke="currentColor" stroke-width="1.4"/></svg><span class="visually-hidden">(opens in a new window)</span>
  <% end %>
<% end %>
