<%= form_with url: project_secret_path(@project.name, key), method: :put, class: "secret__form" do |f| %>
  <%= f.password_field :value, value: nil, autocomplete: "off", placeholder: "Value", "aria-label": "Value for #{key}", class: "mono" %>
  <%= f.submit label, class: "button button--small" %>
<% end %>
