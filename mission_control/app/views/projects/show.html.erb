<% content_for :title, "#{@project.name} · Project" %>
<%# The header and facts strip, then a menu and one column of sections (docs/plans/mission-control-match-design.md, Batch 4). %>
<main class="page project">
  <nav class="mono crumbs"><%= link_to "Projects", root_path %> <span>/</span> <span class="crumbs__here"><%= @project.name %></span></nav>

  <div class="project-head">
    <div class="project-head__main">
      <div class="project-head__title">
        <h1 class="disp"><%= @project.name %></h1>
        <%= state_pill(@project.status) %>
      </div>
      <div class="host-chips">
        <% @project.hostnames(@installation).each do |host| %>
          <% state = @project.domain_states.dig(host, "state") || ("WILDCARD" if host == @project.host(@installation) && @installation.dns_mode != "per_host") %>
          <%= link_to app_url(host), target: "_blank", rel: "noopener noreferrer", class: "host-chip host-chip--#{state.to_s.parameterize.presence || "unknown"}" do %>
            <span class="host-chip__dot"></span><%= host %>
            <% if state %><small class="mono domain-state domain-state--<%= state.parameterize %>" title="<%= @project.domain_states.dig(host, "reason") %>"><%= state %></small><% end %>
            <svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4.5 2H10v5.5M10 2L2.5 9.5" stroke="currentColor" stroke-width="1.4"/></svg>
            <span class="visually-hidden">(opens in a new window)</span>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="project-head__actions">
      <% if (console = @project.console_command) %>
        <div class="console-box" data-controller="clipboard">
          <span class="mono console-box__label">CONSOLE · RUNS <span><%= console %></span> FROM COMPOSE.YML</span>
          <span class="console-box__field">
            <span class="mono console-box__command" data-clipboard-target="source">houston console --server</span>
            <button type="button" data-action="clipboard#copy" data-clipboard-target="button" aria-label="Copy console command">Copy</button>
          </span>
        </div>
      <% end %>
    </div>
  </div>

  <% if @project.maintenance? %>
    <div class="notice notice--hold">
      <span class="mono">MAINTENANCE</span>
      <span class="notice__text"><%= @project.name %> shows a maintenance page since <%= l(@project.maintenance_since, format: :short) %> (<%= @project.maintenance_by %>)<% if @project.maintenance_message.present? %>: “<%= @project.maintenance_message %>”<% end %>. It stays up until you turn it off.</span>
      <%= button_to "Turn it off", project_maintenance_path(@project.name), method: :patch, params: { on: "0" }, class: "button button--small" %>
    </div>
  <% end %>
  <% if notice %>
    <div class="notice notice--go"><span class="mono">OK</span><span class="notice__text"><%= notice %></span></div>
  <% end %>
  <% if alert %>
    <div class="notice notice--nogo"><span class="mono">NO-GO</span><span class="notice__text"><%= alert %></span></div>
  <% end %>

  <div class="facts-strip">
    <div><span class="mono facts-strip__label">RUNNING SHA</span>
      <span class="mono facts-strip__sha"><%= @running&.short_sha || "never deployed" %></span></div>
    <div><span class="mono facts-strip__label">DEPLOY RULE</span>
      <span><%= @project.deploy_rule_words %></span></div>
    <div><span class="mono facts-strip__label">RESOURCES</span>
      <span><%= @project.resources_words || "no limits" %></span></div>
    <div>
      <span class="mono facts-strip__label">SERVICES · <%= @project.accessories.size %></span>
      <span class="facts-strip__services">
        <% @project.accessories.each do |service| %>
          <span class="service"><span class="service__dot"></span><span class="service__name"><%= service %></span> <span class="mono service__image"><%= @project.service_image(service) || "—" %></span></span>
        <% end %>
        <% if @project.accessories.empty? %><span>none besides the app</span><% end %>
      </span>
    </div>
    <div><span class="mono facts-strip__label">REPO</span>
      <span><%= @project.repo_words || "not linked" %></span></div>
  </div>

  <%# Alphabetical, to scan; the sections below are in the same order. %>
  <% sections = [] %>
  <% sections << [ "Connect pushes", "webhook" ] if @project.repo_url.present? %>
  <% sections << [ "Deploy history", "history" ] %>
  <% sections << [ "Maintenance page", "maintenance" ] unless @project.maintenance? %>
  <% sections += [ [ "Secrets", "secrets" ], [ "Snapshots", "snapshots" ] ] %>
  <% sections << [ "Volumes", "volumes" ] if @project.volumes.any? %>
  <div class="project-layout">
    <%= render "shared/section_nav", label: "Project sections", items: sections %>
    <div class="project-sections">
    <% if @project.repo_url.present? %>
      <section class="panel webhook" id="webhook">
        <div class="panel__head"><h2 class="disp panel__title">Connect pushes</h2><span class="panel__meta muted">In the repo's webhook settings</span></div>
        <p class="panel__row">Your git host calls this address on every push. Houston checks the secret, reads the repo's refs itself, and deploys what the deploy rule matches.</p>
        <dl class="plan">
          <dt class="mono">WEBHOOK URL</dt><dd class="mono">https://hooks.<%= @installation.base_domain %>/<%= @project.name %></dd>
          <dt class="mono">SECRET</dt>
          <dd class="mono"><%= @project.webhook_verified_at ? "•••••••• (shown until the first push arrived)" : @project.webhook_secret %></dd>
          <dt class="mono">SEND</dt><dd>Push events, as <span class="mono">application/json</span></dd>
          <dt class="mono">REPO</dt><dd class="mono"><%= @project.repo_url %> · <%= @project.branch %></dd>
        </dl>
        <p class="panel__row panel__row--muted">
          <span>
            <% if @project.webhook_verified_at %>First push arrived <%= time_ago_in_words(@project.webhook_verified_at) %> ago.<% else %>Waiting for the first push. The secret is shown in full only until one arrives.<% end %>
            <% if @hooks_route && @hooks_route.state != :go %><br><%= state_chip(@hooks_route.state == :hold ? :queued : :no_go) %> hooks.<%= @installation.base_domain %>: <%= @hooks_route.reason %><% end %>
            <% if @project.last_check_error %><br><span class="field__error">Last check: <%= @project.last_check_error %></span><% end %>
          </span>
        </p>
        <div class="panel__row panel__row--actions">
          <%= button_to "Check for changes", check_project_path(@project.name), class: "button button--small" %>
          <%= button_to "Rotate secret", rotate_webhook_project_path(@project.name), class: "button button--small" %>
        </div>
      </section>
    <% end %>

    <section class="panel history" id="history">
      <div class="panel__head">
        <h2 class="disp panel__title">Deploy history</h2>
        <span class="panel__meta">
          <span class="mono eyebrow"><%= pluralize(@deploy_count, "deploy").upcase %></span>
          <% if @project.repo_url.present? %>
            <%= button_to "Deploy", project_deploys_path(@project.name), class: "button button--primary button--small",
                          title: "Deploy the head of what the deploy rule matches (#{@project.deploy_rule_words.downcase})" %>
          <% end %>
        </span>
      </div>
      <% if @deploys.empty? %>
        <p class="panel__row panel__row--muted">
          <% if @project.repo_url.present? %>
            No deploys yet. Deploy sends the head of <%= @project.deploy_rule_words.downcase.delete_prefix("every commit to ") %>, and so does every push once the webhook is connected.
          <% else %>
            No deploys yet. On the server, in a checkout of the repo: <span class="mono">houston deploy</span>
          <% end %>
        </p>
      <% end %>
      <% @deploys.each do |deploy| %>
        <div class="history__row <%= "history__row--no-go" if deploy.status == "no_go" %>" data-deploy="<%= deploy.number %>">
          <span class="mono muted">#<%= deploy.number %></span>
          <span class="mono"><%= deploy.short_sha %></span>
          <span class="history__what">
            <span><%= deploy.restore? ? "Restore" : deploy.ref.delete_prefix("refs/heads/").delete_prefix("refs/tags/") %></span>
            <small class="<%= "history__error" if deploy.error.present? %>"><%= deploy.error.presence || "#{time_ago_in_words(deploy.created_at)} ago · #{l(deploy.created_at, format: :short)}" %></small>
          </span>
          <%= state_chip(deploy.status) %>
          <span class="mono muted"><%= { "queued" => "—", "in_flight" => mission_elapsed(deploy.duration) }.fetch(deploy.status) { duration_words(deploy.duration) } %></span>
          <%= link_to "Log", project_deploy_path(@project.name, deploy.number) %>
        </div>
      <% end %>
      <% if @deploy_count > ProjectPage::PER_PAGE %>
        <% first = (@page - 1) * ProjectPage::PER_PAGE + 1 %>
        <nav class="pager" aria-label="Deploy history pages">
          <span class="mono muted pager__range"><%= first %>–<%= [ first + ProjectPage::PER_PAGE - 1, @deploy_count ].min %> of <%= @deploy_count %></span>
          <% if @page > 1 %><%= link_to "← Newer", project_path(@project.name, page: @page - 1), class: "button button--small" %><% else %><span class="button button--small is-disabled">← Newer</span><% end %>
          <span class="mono">Page <%= @page %> of <%= (@deploy_count.to_f / ProjectPage::PER_PAGE).ceil %></span>
          <% if @page * ProjectPage::PER_PAGE < @deploy_count %><%= link_to "Older →", project_path(@project.name, page: @page + 1), class: "button button--small" %><% else %><span class="button button--small is-disabled">Older →</span><% end %>
        </nav>
      <% end %>
    </section>

    <% unless @project.maintenance? %>
      <section class="panel maintenance" id="maintenance">
        <div class="panel__head"><h2 class="disp panel__title">Maintenance page</h2></div>
        <p class="panel__row panel__row--muted">Houston shows it on every hostname of <%= @project.name %>, whatever state the app is in, until you turn it off. Deploys and restores never change it.</p>
        <iframe class="maintenance__preview" sandbox="" src="<%= preview_project_maintenance_path(@project.name) %>" title="Maintenance page preview" loading="lazy"></iframe>
        <p class="panel__row panel__row--muted"><%= @project.maintenance_page.present? ? "The project's own page (x-houston.maintenance)." : "Houston's default page. Set x-houston.maintenance in compose.yml to use your own." %></p>
        <%= form_with url: project_maintenance_path(@project.name), method: :patch, class: "panel__row inline-form" do |f| %>
          <%= hidden_field_tag :on, "1" %>
          <%= f.text_field :message, placeholder: "Message (optional)", maxlength: 500, "aria-label": "Maintenance message" %>
          <%= f.submit "Show maintenance page", class: "button button--small", data: { turbo_confirm: "Visitors to #{@project.name} will see the maintenance page within seconds. Show it?" } %>
        <% end %>
      </section>
    <% end %>

    <section class="panel secrets" id="secrets">
      <div class="panel__head">
        <h2 class="disp panel__title">Secrets</h2>
        <span class="panel__meta muted">Values are write-only.</span>
      </div>
      <% if @missing.any? %>
        <div class="notice notice--nogo"><span class="mono">HOLD</span><span class="notice__text">The next deploy will stop until <%= @missing.to_sentence %> <%= @missing.one? ? "has" : "have" %> a value.</span></div>
      <% end %>
      <% if @variables.empty? %>
        <p class="panel__row panel__row--muted">compose.yml references no variables.</p>
      <% end %>
      <% @variables.each do |variable| %>
        <% key = variable["name"] %>
        <% secret, error = @secrets[key], @secret_errors[key] %>
        <% set = secret.present? && secret.value.present? %>
        <% form_id = "secret-form-#{key}" %>
        <div class="secret <%= "secret--missing" if !set && variable["required"] %>" id="secret-<%= key %>" data-secret="<%= key %>">
          <span class="mono secret__name"><%= key %><% unless variable["required"] %> <small>optional</small><% end %></span>
          <% if set && params[:replace] != key && !error %>
            <span class="muted">•••••••• · set <%= l(secret.updated_at.to_date, format: :short) %></span>
            <span class="secret__actions">
              <%= link_to "Replace", project_path(@project.name, replace: key, anchor: "secret-#{key}") %>
              <%= button_to "Remove", project_secret_path(@project.name, key), method: :delete, class: "link-button link-button--danger",
                            data: { turbo_confirm: "Remove #{key}? #{variable["required"] ? "The next deploy will stop until it has a value again." : "The app gets it blank."}" } %>
            </span>
          <% else %>
            <input type="password" name="value" id="<%= form_id %>-value" form="<%= form_id %>" class="mono" autocomplete="off" placeholder="<%= set ? "New value" : "Paste value" %>" aria-label="Value for <%= key %>">
            <span class="secret__actions">
              <%= form_with url: project_secret_path(@project.name, key), method: :put, id: form_id do |f| %>
                <%= f.submit set ? "Replace" : "Save value", class: "button button--primary button--small" %>
              <% end %>
              <% if set %>
                <%= link_to "Cancel", project_path(@project.name, anchor: "secret-#{key}") %>
              <% else %>
                <%= button_to "Generate", generate_project_secret_path(@project.name, key), class: "link-button", title: "Save a random value nobody needs to know" %>
              <% end %>
            </span>
          <% end %>
          <% if error %><span class="field__error secret__error"><%= key %> <%= error %></span><% end %>
        </div>
      <% end %>
    </section>

    <%# The head renders with the page; the list is a lazy frame, since reading a repository can take seconds. %>
    <section class="panel snapshots" id="snapshots">
      <div class="panel__head">
        <h2 class="disp panel__title">Snapshots</h2>
        <span class="panel__meta">
          <% if @storage %>
            <span class="mono eyebrow"><%= @storage.name %></span>
            <%= button_to "Create", project_backups_path(@project.name), class: "button button--primary button--small", title: "Take a snapshot of #{@project.name} now: code and data" %>
          <% end %>
        </span>
      </div>
      <% if @storage %><%= render "projects/backup_run", run: @backup %><% end %>
      <%= turbo_frame_tag "snapshots-list", src: project_snapshots_path(@project.name, kind: params[:snapshots].presence_in(%w[deploy settings])), loading: :lazy do %>
        <p class="panel__row panel__row--muted">Reading the snapshots…</p>
      <% end %>
    </section>

    <% if @project.volumes.any? %>
      <section class="panel volumes" id="volumes">
        <div class="panel__head"><h2 class="disp panel__title">Volumes</h2><span class="panel__meta muted">Where each one lives</span></div>
        <% sqlite_volumes = @last_good_backup&.found.to_h.fetch("sqlite", []).map { |f| f["volume"] } %>
        <% @project.volume_rows.each do |volume, row| %>
          <div class="panel__row" data-volume="<%= volume["name"] %>">
            <span><span class="mono"><%= volume["name"] %></span> → <span class="mono"><%= volume["path"] %></span></span>
            <% if row&.placed_at %>
              <span><%= row.where_words %> · <small class="muted">moving a volume is a later feature</small></span>
            <% else %>
              <%= form_with url: project_volume_path(@project.name, volume["name"]), method: :patch, class: "inline-form" do |f| %>
                <%= f.select :location, [ [ "Local disk (this server)", "" ] ] + @live_locations.map { |l| [ l.choice_label, l.name ] }, { selected: row&.location&.name.to_s }, "aria-label": "Where #{volume["name"]} lives" %>
                <%= f.submit "Save", class: "button button--small" %>
              <% end %>
            <% end %>
            <% if row&.location&.kind == "nfs" %>
              <small class="field__error">Live SQLite over a network share risks corruption<%= ": this volume holds SQLite databases" if sqlite_volumes.include?(volume["name"]) %>.</small>
            <% end %>
          </div>
        <% end %>
        <p class="panel__row panel__row--muted">Chosen before Houston makes the volume, at its first deploy. Local disk is the server's own disk, and right for databases. Postgres data always stays on local disk.</p>
      </section>
    <% end %>
  </div>
  </div>
</main>
