<% content_for :title, "#{@project.name} · Project" %>
<main class="page board">
  <nav class="mono eyebrow crumbs"><%= link_to "Projects", root_path %> / <%= @project.name %></nav>
  <div class="board__top">
    <div class="board__title">
      <h1 class="disp"><%= @project.name %></h1>
      <div class="hosts">
        <%= state_chip(@project.status) %>
        <% ([ @project.host(@installation) ] + @project.domains).each do |host| %>
          <%= link_to host, app_url(host), target: "_blank", rel: "noopener noreferrer", class: "mono" %>
          <%= render "projects/domain_state", project: @project, host: %>
        <% end %>
      </div>
    </div>
    <% if @storage %>
      <div class="backup-now">
        <%= button_to "Back up now", project_backups_path(@project.name), class: "button button--small" %>
        <%= render "projects/backup_run", run: @backup %>
      </div>
    <% end %>
  </div>

  <% if notice %>
    <div class="notice notice--go"><span class="mono">OK</span><span class="notice__text"><%= notice %></span></div>
  <% end %>
  <% if alert %>
    <div class="notice notice--nogo"><span class="mono">NO-GO</span><span class="notice__text"><%= alert %></span></div>
  <% end %>

  <div class="board__body">
    <div class="column">
      <dl class="facts">
        <dt class="mono">RUNNING SHA</dt><dd class="mono"><%= @running&.short_sha || "— (never deployed)" %></dd>
        <dt class="mono">DEPLOY RULE</dt><dd><%= @project.deploy_rule_words %></dd>
        <dt class="mono">SERVICES</dt><dd class="mono"><%= @project.accessories.presence&.join(" · ") || "none besides the app" %></dd>
        <dt class="mono">HEALTH</dt><dd class="mono"><%= @project.health %> on port <%= @project.port %></dd>
      </dl>

      <section class="panel history">
        <h2 class="disp panel__title">Deploy history <small class="mono eyebrow"><%= pluralize(@deploy_count, "deploy") %></small></h2>
        <% if @deploys.empty? %>
          <p class="panel__row panel__row--muted">No deploys yet. On the server, in a checkout of the repo: <span class="mono">houston deploy</span></p>
        <% end %>
        <ul class="rows">
          <% @deploys.each do |deploy| %>
            <li data-deploy="<%= deploy.number %>">
              <span class="mono">#<%= deploy.number %></span>
              <span class="mono"><%= deploy.short_sha %></span>
              <span>
                <%= deploy.ref.delete_prefix("refs/heads/").delete_prefix("refs/tags/") %> · <%= l(deploy.created_at, format: :short) %>
                <% if deploy.error.present? %><small><%= deploy.error %></small><% end %>
              </span>
              <%= state_chip(deploy.status) %>
              <span class="mono"><%= { "queued" => "—", "in_flight" => mission_elapsed(deploy.duration) }.fetch(deploy.status) { duration_words(deploy.duration) } %></span>
              <%= link_to "Log", project_deploy_path(@project.name, deploy.number) %>
            </li>
          <% end %>
        </ul>
        <% if @deploy_count > ProjectPage::PER_PAGE %>
          <p class="panel__row pager">
            <% if @page > 1 %><%= link_to "← Newer", project_path(@project.name, page: @page - 1) %><% end %>
            <span class="mono">Page <%= @page %> of <%= (@deploy_count.to_f / ProjectPage::PER_PAGE).ceil %></span>
            <% if @page * ProjectPage::PER_PAGE < @deploy_count %><%= link_to "Older →", project_path(@project.name, page: @page + 1) %><% end %>
          </p>
        <% end %>
      </section>
    </div>

    <div class="column column--side">
    <% if @project.repo_url.present? %>
      <section class="panel webhook">
        <h2 class="disp panel__title">Connect pushes</h2>
        <p class="panel__row">Your git host calls this address on every push. Houston checks the secret, reads the repo's refs itself, and deploys what the deploy rule matches.</p>
        <dl class="facts">
          <dt class="mono">WEBHOOK URL</dt><dd class="mono">https://hooks.<%= @installation.base_domain %>/<%= @project.name %></dd>
          <dt class="mono">SECRET</dt>
          <dd class="mono"><%= @project.webhook_verified_at ? "•••••••• (shown until the first push arrived)" : @project.webhook_secret %></dd>
          <dt class="mono">SEND</dt><dd>Push events, as application/json</dd>
          <dt class="mono">REPO</dt><dd class="mono"><%= @project.repo_url %> · <%= @project.branch %></dd>
        </dl>
        <p class="panel__row panel__row--muted">
          <% if @project.webhook_verified_at %>First push arrived <%= time_ago_in_words(@project.webhook_verified_at) %> ago.<% else %>Waiting for the first push. The secret is shown in full only until one arrives.<% end %>
          <% if @hooks_route && @hooks_route.state != :go %><br><%= state_chip(@hooks_route.state == :hold ? :queued : :no_go) %> hooks.<%= @installation.base_domain %>: <%= @hooks_route.reason %><% end %>
          <% if @project.last_check_error %><br><span class="field__error">Last check: <%= @project.last_check_error %></span><% end %>
        </p>
        <div class="panel__row webhook__actions">
          <%= button_to "Check for changes", check_project_path(@project.name), class: "button button--small" %>
          <%= button_to "Rotate secret", rotate_webhook_project_path(@project.name), class: "button button--small" %>
        </div>
      </section>
    <% end %>
    <aside class="panel secrets">
      <h2 class="disp panel__title">Secrets</h2>
      <p class="panel__row panel__row--muted">Values are write-only: Houston never shows them again.</p>
      <% required_missing = @missing %>
      <% if required_missing.any? %>
        <div class="notice notice--hold"><span class="mono">HOLD</span><span class="notice__text">The next deploy will stop until <%= required_missing.to_sentence %> <%= required_missing.one? ? "has" : "have" %> a value.</span></div>
      <% end %>
      <% if @variables.empty? %>
        <p class="panel__row panel__row--muted">compose.yml references no variables.</p>
      <% end %>
      <% @variables.each do |variable| %>
        <% key = variable["name"] %>
        <% secret, error = @secrets[key], @secret_errors[key] %>
        <% set = secret.present? && secret.value.present? %>
        <div class="panel__row secret" data-secret="<%= key %>">
          <span class="mono"><%= key %><% unless variable["required"] %> <small>optional</small><% end %></span>
          <% if set %>
            <span class="mono">•••••••• · set <%= l(secret.updated_at.to_date, format: :short) %></span>
            <details class="secret__replace" <%= "open" if error %>>
              <summary>Replace</summary>
              <%= render "projects/secret_form", key:, label: "Replace" %>
            </details>
            <%= button_to "Remove", project_secret_path(@project.name, key), method: :delete, class: "button button--small" %>
          <% else %>
            <%= render "projects/secret_form", key:, label: "Save value" %>
            <%= button_to "Generate", generate_project_secret_path(@project.name, key), class: "button button--small", title: "Save a random value nobody needs to know" %>
          <% end %>
          <% if error %><span class="field__error"><%= key %> <%= error %></span><% end %>
        </div>
      <% end %>
    </aside>
    </div>
  </div>
</main>
