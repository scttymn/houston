<%# A project's latest deploy, in words (the flight board's row and phone card). %>
<% if latest.nil? %>
  <span>Never deployed</span><small>Deploy on its page, or run houston deploy</small>
<% elsif latest.status == "in_flight" %>
  <%= link_to "Deploying · #{mission_elapsed(latest.duration)}", project_deploy_path(project.name, latest.number), class: "flight__deploying" %>
  <small><%= latest.step.presence || "starting" %></small>
<% elsif latest.status == "no_go" %>
  <%= link_to "Failed #{time_ago_in_words(latest.finished_at)} ago", project_deploy_path(project.name, latest.number), class: "flight__failed" %>
  <small><%= latest.short_sha %> · <%= latest.error %></small>
<% elsif latest.status == "queued" %>
  <%= link_to "Queued", project_deploy_path(project.name, latest.number) %>
  <small><%= latest.short_sha %></small>
<% else %>
  <%= link_to "#{time_ago_in_words(latest.finished_at)} ago · #{duration_words(latest.duration)}", project_deploy_path(project.name, latest.number), class: "flight__plain" %>
  <small><%= latest.ref.delete_prefix("refs/heads/").delete_prefix("refs/tags/") %></small>
<% end %>
