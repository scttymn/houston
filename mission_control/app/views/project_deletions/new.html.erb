<% content_for :title, "Delete #{@project.name}" %>
<%# Delete a project (docs/plans/delete-project.md): the Restore dialog's layout, over the dimmed project page. %>
<main class="restore">
  <section class="restore__dialog" role="dialog" aria-labelledby="delete-title">
    <div class="mono restore__banner"><span>DELETE · WHOLE PROJECT</span><span>CAN'T BE UNDONE</span></div>
    <div class="restore__body">
      <nav class="mono crumbs"><%= link_to "Projects", root_path %> <span>/</span> <%= link_to @project.name, project_path(@project.name) %> <span>/</span> <span class="crumbs__here">Delete</span></nav>
      <h1 class="disp" id="delete-title">Delete <%= @project.name %>?</h1>

      <dl class="plan delete-list">
        <dt class="mono">CONTAINERS</dt>
        <dd class="mono"><%= ([ "#{@project.name}-web" ] + @project.accessories.map { |s| @project.generation.container(s) }).join(", ") %></dd>
        <dt class="mono">DATA</dt>
        <% data = @project.volume_rows.map { |volume, row| "#{volume["name"]} (#{row&.location&.name || "local disk"})" } %>
        <% data << "what #{@project.accessories.to_sentence} hold" if @project.accessories.any? %>
        <dd><%= data.presence&.join("; ") || "none" %></dd>
        <dt class="mono">DOMAINS</dt>
        <dd class="mono"><%= @project.hostnames(@installation).join(", ") %></dd>
        <dt class="mono">ON THE SERVER</dt>
        <dd>Kamal's files for it (with its secret values), the runners' checkouts, its images</dd>
        <dt class="mono">MISSION CONTROL</dt>
        <dd>Its secrets, deploy history and settings</dd>
      </dl>

      <div class="restore-note">
        <span class="mono">KEPT</span>
        <span>
          <% if @kept && @storage %>
            A final snapshot of <%= @project.name %>'s data goes to <%= @storage.name %> first, and its backups stay<%= " (#{@backup_locations.map(&:name).to_sentence})" if @backup_locations.any? %>.
            Add a project named <%= @project.name %> again to restore one.
          <% elsif @kept %>
            There's no backup storage for a final snapshot: finish setup's storage step first, or delete the backups too.
          <% else %>
            <%= @project.name %> has no data to snapshot<%= ", and its backups stay (#{@backup_locations.map(&:name).to_sentence})" if @backup_locations.any? %>.
          <% end %>
          Houston can't remove the deploy key and the webhook on the git host<%= " (#{@project.repo_url})" if @project.repo_url.present? %>; remove them there.
        </span>
      </div>

      <%= form_with url: project_deletion_path(@project.name), class: "restore__confirm" do |f| %>
        <label class="check">
          <%= check_box_tag :delete_backups, "1", params[:delete_backups] == "1" %>
          <span>Also delete its backups: every snapshot of <%= @project.name %><%= " in #{@backup_locations.map(&:name).to_sentence}" if @backup_locations.any? %>, and no final snapshot. They can't be brought back.</span>
        </label>
        <div class="field">
          <label for="confirm">Type <span class="mono"><%= @project.name %></span> to confirm</label>
          <%= text_field_tag :confirm, nil, id: "confirm", class: "mono", autocomplete: "off" %>
          <% if @error %><span class="field__error"><%= @error %></span><% end %>
        </div>
        <div class="restore__actions">
          <span class="mono muted">CLI: houston delete --confirm <%= @project.name %></span>
          <%= link_to "Cancel", project_path(@project.name), class: "button button--medium button--quiet" %>
          <%= f.submit "Delete #{@project.name}", class: "button button--danger button--medium" %>
        </div>
      <% end %>
    </div>
  </section>
</main>
