<% content_for :title, "#{@project.name} · Deploy ##{@deploy.number}" %>
<%= turbo_stream_from @deploy %>
<main class="page board">
  <nav class="mono eyebrow crumbs"><%= link_to "Projects", root_path %> / <%= link_to @project.name, project_path(@project.name) %> / Deploy #<%= @deploy.number %></nav>
  <div class="board__top">
    <div class="board__title">
      <h1 class="disp">Deploy #<%= @deploy.number %></h1>
    </div>
    <div class="stat">
      <span class="mono eyebrow">STARTED <%= @deploy.created_at.utc.strftime("%H:%M:%S") %> UTC</span>
      <span class="disp stat__value"><%= @deploy.finished_at ? duration_words(@deploy.duration) : "—" %></span>
    </div>
  </div>

  <%= render "deploys/status", deploy: @deploy, project: @project, running: @running %>

  <div class="board__body">
    <%= render "deploys/steps", deploy: @deploy %>
    <section class="panel log-panel" data-controller="follow clipboard">
      <div class="panel__title log-panel__head">
        <h2 class="disp"><%= @project.name %> · <%= @deploy.short_sha %></h2>
        <label class="mono"><input type="checkbox" checked data-follow-target="toggle" data-action="change->follow#toggle"> Follow</label>
        <button type="button" class="button button--small" data-action="clipboard#copy" data-clipboard-target="button">Copy log</button>
      </div>
      <pre id="deploy_log" class="mono log" data-follow-target="log" data-clipboard-target="source" data-action="scroll->follow#scrolled"><%= @deploy.log %></pre>
    </section>
  </div>
</main>
