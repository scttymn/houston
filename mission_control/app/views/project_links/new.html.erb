<% content_for :title, "Add project · Mission Control" %>
<% found = @link&.preview %>
<main class="page board link">
  <nav class="mono eyebrow crumbs"><%= link_to "Projects", root_path %> / Add project</nav>
  <div class="board__title">
    <h1 class="disp">Add project</h1>
    <p>Link a repo. Mission Control reads its compose.yml, then you set its secrets on the project's page.</p>
  </div>

  <section class="panel link-step">
    <h2 class="disp panel__title"><span class="mono">01</span> Link the repo</h2>
    <%= form_with url: link_access_path, class: "panel__row" do |f| %>
      <%= f.label :repo_url, "Repo URL" %>
      <%= f.text_field :repo_url, value: @entered_url || @link&.repo_url, class: "mono", placeholder: "git@github.com:you/app.git", autocomplete: "off" %>
      <span class="field__hint">Any git host. SSH or HTTPS URL.</span>
      <% if @url_error %><span class="field__error">The repo URL <%= @url_error %></span><% end %>
      <%= f.submit "Check access", class: "button button--small" %>
    <% end %>
    <% if @link %>
      <div class="panel__row" data-controller="clipboard">
        <span class="mono eyebrow">READ ACCESS · DEPLOY KEY</span>
        <span>Add this key to the repo as a read-only deploy key. Public repos can skip it.</span>
        <pre class="mono deploy-key" data-clipboard-target="source"><%= @link.deploy_key_public %></pre>
        <button type="button" class="button button--small" data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
      </div>
    <% end %>
    <% if @access %>
      <p class="panel__row check"><span class="mono check__state check__state--<%= @access.ok ? "go" : "nogo" %>"><%= @access.ok ? "GO" : "NO-GO" %></span><span><%= @access.message %></span></p>
    <% end %>
  </section>

  <% if @link %>
    <section class="panel link-step">
      <h2 class="disp panel__title"><span class="mono">02</span> Read compose.yml</h2>
      <%= form_with url: link_read_path, class: "panel__row" do |f| %>
        <%= f.label :branch, "Branch to read" %>
        <%= f.text_field :branch, value: @link.branch, class: "mono" %>
        <% @link.errors[:branch].each do |e| %><span class="field__error">The branch <%= e %></span><% end %>
        <%= f.label :compose_path, "Config path" %>
        <%= f.text_field :compose_path, value: @link.compose_path, class: "mono" %>
        <% @link.errors[:compose_path].each do |e| %><span class="field__error">The config path <%= e %></span><% end %>
        <%= f.submit "Read compose.yml", class: "button button--small" %>
      <% end %>
      <p class="panel__row panel__row--muted">No x-houston block yet? Run <span class="mono">houston init</span> in the repo and push it first.</p>
      <% if @problems %>
        <div class="panel__row problems"><span class="mono check__state--nogo">NO-GO</span><pre class="mono"><%= @problems %></pre></div>
      <% end %>
    </section>
  <% end %>

  <% if found %>
    <% sync, pv = found["sync"], found["preview"] %>
    <section class="panel found">
      <h2 class="disp panel__title">What Houston found <small class="mono"><%= @link.branch %> @ <%= @link.preview_sha.to_s.first(7) %></small></h2>
      <dl class="facts">
        <dt class="mono">NAME</dt><dd class="mono"><%= sync["name"] %> → <%= sync["name"] %>.<%= @installation.base_domain %></dd>
        <dt class="mono">DOMAINS</dt><dd class="mono"><%= ([ "#{sync["name"]}.#{@installation.base_domain}" ] + sync["domains"]).join(" · ") %></dd>
        <% app = [ "Port #{pv["port"]}", "health #{pv["health"]}" ] %>
        <% app << "#{pv["cpus"]} #{"CPU".pluralize(pv["cpus"].to_f)}" if pv["cpus"] %>
        <% app << pv["memory"] if pv["memory"] %>
        <dt class="mono">APP</dt><dd><%= app.join(" · ") %></dd>
        <% services = pv["services"].reject { |s| s["app"] } %>
        <dt class="mono">SERVICES</dt><dd class="mono"><%= services.map { |s| "#{s["name"]} · #{s["image"]}" }.join(", ").presence || "none besides the app" %></dd>
        <% rule = sync["deploy_rule"] %>
        <dt class="mono">DEPLOYS</dt><dd><%= rule["on"] == "tag" ? "Tags matching #{rule["tags"]}" : "Every commit to #{rule["branch"]}" %><%= " · tests run first" if pv["test"] %></dd>
        <% b = pv["backups"] %>
        <dt class="mono">BACKUPS</dt><dd><%= b["schedule"] %> · keep <%= b["keep_auto"] %> auto, <%= b["keep_deploy"] %> deploy<%= " · volumes #{b["volumes"].join(", ")}" if b["volumes"].any? %></dd>
        <dt class="mono">SECRETS</dt><dd class="mono"><%= sync["variables"].map { |v| v["name"] + (v["required"] ? "" : " (optional)") }.join(", ").presence || "none" %></dd>
      </dl>
    </section>
  <% end %>

  <% if @save_error %><p class="field__error"><%= @save_error %></p><% end %>
  <% if @link %>
    <%= form_with url: link_path, class: "link-save" do |f| %>
      <% volumes = @link.found? ? @link.preview.dig("sync", "volumes").to_a : [] %>
      <% if volumes.any? %>
        <fieldset class="link-volumes">
          <legend class="mono eyebrow">VOLUMES · where each one lives</legend>
          <% live = StorageLocation.where.not(acknowledged_at: nil).order(:name).select(&:live?) %>
          <% volumes.each do |volume| %>
            <label><span class="mono"><%= volume["name"] %></span> → <span class="mono"><%= volume["path"] %></span>
              <%= select_tag "locations[#{volume["name"]}]", options_for_select([ [ "Local disk", "" ] ] + live.map { |l| [ l.name, l.name ] }) %>
            </label>
          <% end %>
        </fieldset>
      <% end %>
      <%= link_to "Cancel", root_path %>
      <%= f.button "Save", class: "button button--primary", disabled: !found %>
    <% end %>
  <% end %>
</main>
