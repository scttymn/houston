<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Mission Control" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Mission Control">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Fingerprinted: Cloudflare caches them for a year, so a changed icon gets a new URL. %>
    <link rel="icon" href="<%= asset_path("icon.png") %>" type="image/png">
    <link rel="icon" href="<%= asset_path("icon.svg") %>" type="image/svg+xml">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if content_for?(:setup_step) %>
      <%= render "shared/setup_header", step: content_for(:setup_step).to_i %>
    <% else %>
      <%= render "shared/header" %>
    <% end %>
    <%= yield %>
  </body>
</html>
