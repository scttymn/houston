<%# The top bar. On a phone (the design's MobileFlightBoard and MobileMenu):
    the brand, a menu button, and a status strip under it; the menu holds
    the nav, the systems and Sign out. %>
<div class="topbar-shell" data-controller="menu" data-action="keydown.esc@window->menu#close">
<header class="topbar">
  <%= render "shared/brand" %>
  <% if authenticated? %>
    <% settings = controller_path.start_with?("settings/") %>
    <nav class="topbar__nav">
      <%= link_to "Projects", root_path, class: ("is-current" unless settings) %>
      <%= link_to "Settings", settings_path, class: ("is-current" if settings) %>
    </nav>
    <span class="topbar__spacer"></span>
    <% if Setup.next_step.nil? %>
      <% tunnel_go, registry_go = SystemStatus.tunnel.go?, SystemStatus.registry_up? %>
      <div class="mono status">
        <span>TUNNEL <%= status_word(tunnel_go) %></span>
        <% if (expected = ENV["HOUSTON_RUNNERS"].to_i).positive? %>
          <% live = Runner.live_count %>
          <span>RUNNERS <%= live %>/<%= expected %> <%= status_word(live >= expected) %></span>
        <% end %>
        <span>REGISTRY <%= status_word(registry_go) %></span>
        <span class="status__clock"><%= Time.current.strftime("%H:%M %Z") %></span>
      </div>
    <% end %>
    <%= button_to "Sign out", session_path, method: :delete, class: "topbar__signout" %>
    <button type="button" class="topbar__menu" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu" data-menu-target="button" data-action="menu#open">
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.8"/></svg>
    </button>
    <% if Setup.next_step.nil? %>
      <% strip = capture do %>
        <div class="mono topbar__strip">
          <span>TUNNEL <%= status_word(tunnel_go) %></span>
          <span>REGISTRY <%= status_word(registry_go) %></span>
          <span class="topbar__spacer"></span>
          <span class="status__clock"><%= Time.current.strftime("%H:%M %Z") %></span>
        </div>
      <% end %>
      <%= strip %>
    <% end %>

  <% end %>
</header>
<% if authenticated? %>
    <div id="mobile-menu" class="mobile-menu" hidden data-menu-target="panel">
      <div class="mobile-menu__bar">
        <%= render "shared/brand" %>
        <span class="topbar__spacer"></span>
        <button type="button" class="topbar__menu" aria-label="Close menu" data-menu-target="close" data-action="menu#close">
          <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.8"/></svg>
        </button>
      </div>
      <%= strip if Setup.next_step.nil? %>
      <nav class="mobile-menu__nav" aria-label="Main">
        <% chevron = '<svg width="10" height="16" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M2 2l6 6-6 6" stroke="currentColor" stroke-width="1.6"/></svg>'.html_safe %>
        <%= link_to root_path, class: ("is-current" unless settings) do %>Projects<%= chevron %><% end %>
        <%= link_to settings_path, class: ("is-current" if settings) do %>Settings<%= chevron %><% end %>
      </nav>
      <% if Setup.next_step.nil? %>
        <div class="mobile-menu__systems">
          <span class="mono mobile-menu__label">SYSTEMS</span>
          <div><span>Tunnel</span><span class="mono"><%= status_word(tunnel_go) %></span></div>
          <div><span>Registry</span><span class="mono"><%= status_word(registry_go) %></span></div>
          <div><span>Version</span><span class="mono"><%= HoustonVersion.current %></span></div>
        </div>
      <% end %>
      <div class="mobile-menu__foot">
        <%= button_to "Sign out", session_path, method: :delete, class: "mobile-menu__signout" %>
      </div>
    </div>
<% end %>
</div>
