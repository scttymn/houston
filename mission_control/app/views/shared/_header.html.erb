<header class="topbar">
  <%= render "shared/brand" %>
  <% if authenticated? %>
    <nav class="topbar__nav">
      <%= link_to "Projects", root_path, class: ("is-current" unless controller_path.start_with?("settings/")) %>
      <%= link_to "Settings", settings_path, class: ("is-current" if controller_path.start_with?("settings/")) %>
    </nav>
    <span class="topbar__spacer"></span>
    <% if Setup.next_step.nil? %>
      <% tunnel = SystemStatus.tunnel %>
      <div class="mono status">
        <span>TUNNEL <%= status_word(tunnel.go?) %></span>
        <% if (expected = ENV["HOUSTON_RUNNERS"].to_i).positive? %>
          <% live = Runner.live_count %>
          <span>RUNNERS <%= live %>/<%= expected %> <%= status_word(live >= expected) %></span>
        <% end %>
        <span>REGISTRY <%= status_word(SystemStatus.registry_up?) %></span>
        <span class="status__clock"><%= Time.current.strftime("%H:%M %Z") %></span>
      </div>
    <% end %>
    <%= button_to "Sign out", session_path, method: :delete, class: "topbar__signout" %>
  <% end %>
</header>
