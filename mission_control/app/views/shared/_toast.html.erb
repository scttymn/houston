<%# What just happened (flash[:toast]: kind go or nogo, and text), in a corner, gone after a few seconds. %>
<% if (toast = flash[:toast]) %>
  <div class="toast <%= toast["kind"] == "nogo" ? "toast--nogo" : "toast--go" %>" role="status" data-controller="toast" data-action="click->toast#dismiss"><%= toast["text"] %></div>
<% end %>
