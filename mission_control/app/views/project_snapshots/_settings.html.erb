<%# Snapshots' Settings tab: the backup plan (docs/plans/mission-control-match-design.md). %>
<div class="snapshot-settings">
  <p class="snapshots__rule">Edit in compose.yml: the schedule, what's kept and the volumes come from its x-houston block. Where the snapshots go is chosen here.</p>
  <dl class="plan">
    <dt class="mono">SCHEDULE</dt><dd><%= BackupSchedule.new(@project, Installation.current.zone).words %>, plus any you create</dd>
    <dt class="mono">STORAGE</dt>
    <dd>
      <%= form_with url: project_backup_target_path(@project.name), method: :patch, class: "inline-form", data: { turbo_frame: "_top" } do |f| %>
        <% default = StorageLocation.where(default: true).where.not(acknowledged_at: nil).first %>
        <%= f.select :location, [ [ "#{default&.name || "none yet"} (default)", "" ] ] + StorageLocation.where.not(acknowledged_at: nil).where.not(id: default&.id).order(:name).map { |l| [ l.name, l.name ] },
                     { selected: @project.chosen_backup_location&.acknowledged? ? @project.chosen_backup_location.name : "" }, "aria-label": "Backup storage" %>
        <%= f.submit "Save", class: "button button--small" %>
      <% end %>
      <small class="muted">Backing up to <span class="mono"><%= @storage&.name || "none yet" %></span>. Earlier snapshots stay where they were written.</small>
    </dd>
    <dt class="mono">KEEP</dt><dd><%= @project.keep_auto %> scheduled · <%= @project.keep_deploy %> pre-deploy</dd>
    <dt class="mono">VOLUMES</dt>
    <dd class="plan__list"><% if @project.volumes.empty? %>none<% end %><% @project.volumes.each do |volume| %><span><span class="mono"><%= volume["name"] %></span> → <%= volume["path"] %></span><% end %></dd>
    <dt class="mono">DATABASES</dt>
    <dd class="plan__list">
      <% @project.databases.each do |db| %><span><span class="mono"><%= db["service"] %></span> · pg_dump</span><% end %>
      <% @last_good_backup&.found.to_h.fetch("sqlite", []).each do |file| %><span><span class="mono"><%= file["path"] %></span> · .backup</span><% end %>
      <% if @project.databases.empty? && @last_good_backup&.found.to_h.fetch("sqlite", []).blank? %><span>none found yet</span><% end %>
    </dd>
    <% if @project.not_backed_up.any? %>
      <dt class="mono">NOT BACKED UP</dt><dd class="muted"><span class="mono"><%= @project.not_backed_up.join(", ") %></span> · start empty after a restore</dd>
    <% end %>
  </dl>
</div>
