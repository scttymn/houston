<%# The list inside the project page's Snapshots panel (its head is on the page), and its Settings tab. %>
<%= turbo_frame_tag "snapshots-list" do %>
  <% if !@location %>
    <p class="panel__row panel__row--muted">No backup storage yet. Set a default in Settings › Storage.</p>
  <% else %>
    <nav class="tabs" role="tablist" aria-label="Snapshots">
      <% [ [ "auto", "Scheduled" ], [ "deploy", "Pre-deploy" ], [ "settings", "Settings" ] ].each do |kind, label| %>
        <%= link_to project_snapshots_path(@project.name, kind: (kind unless kind == "auto")), role: "tab", "aria-selected": (@kind == kind).to_s, class: "tabs__tab" do %><span class="tabs__label" data-label="<%= label %>"><%= label %></span><% end %>
      <% end %>
    </nav>
    <% if @kind == "settings" %>
      <%= render "project_snapshots/settings" %>
    <% elsif @error %>
      <p class="panel__row"><span class="field__error">Can't read snapshots: <%= @error %></span></p>
    <% else %>
      <p class="snapshots__rule">
        <% if @kind == "auto" %>
          <%= BackupSchedule.new(@project, Installation.current.zone).words %>, plus any you create. One per day is kept for <%= @project.keep_auto %> days · kept <%= @counts.fetch("auto", 0) %> / <%= @project.keep_auto %>.
        <% else %>
          Taken right before every deploy and restore, of the version that was running. The last <%= @project.keep_deploy %> are kept · kept <%= @counts.fetch("deploy", 0) %> / <%= @project.keep_deploy %>.
        <% end %>
      </p>
      <% if @snapshots.empty? %>
        <p class="panel__row panel__row--muted">None yet.</p>
      <% end %>
      <% @snapshots.each do |snapshot| %>
        <div class="snapshots__row" data-snapshot="<%= snapshot.short_id %>">
          <span class="snapshots__when">
            <span><%= l(snapshot.time.in_time_zone, format: :short) %></span>
            <small><%= { "manual" => "created by hand", "schedule" => "daily", "restore" => "before a restore" }.fetch(snapshot.reason) { snapshot.deploy ? "before deploy ##{snapshot.deploy}" : snapshot.reason } %></small>
          </span>
          <span class="mono"><%= snapshot.sha.to_s.first(7) %></span>
          <span class="mono muted"><%= snapshot.bytes ? number_to_human_size(snapshot.bytes) : "—" %></span>
          <%= link_to "Restore", new_project_restore_path(@project.name, snapshot: snapshot.short_id, location: @location.name), data: { turbo_frame: "_top" } %>
        </div>
      <% end %>
      <p class="panel__row panel__row--muted">Each snapshot holds code and data together.</p>
    <% end %>
  <% end %>
<% end %>
