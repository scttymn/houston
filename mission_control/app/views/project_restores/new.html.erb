<% content_for :title, "Restore #{@project.name}" %>
<%# The design's Restore: a dialog over the dimmed project page. %>
<main class="restore">
  <section class="restore__dialog" role="dialog" aria-labelledby="restore-title">
    <div class="mono restore__banner"><span>RESTORE · WHOLE PROJECT</span><span>CODE + DATA</span></div>
    <div class="restore__body">
      <nav class="mono crumbs"><%= link_to "Projects", root_path %> <span>/</span> <%= link_to @project.name, project_path(@project.name) %> <span>/</span> <span class="crumbs__here">Restore</span></nav>
      <h1 class="disp" id="restore-title">Roll <%= @project.name %> back to <%= l(@snapshot.time, format: :short) %>?</h1>

      <div class="restore-compare">
        <span></span><span class="mono restore-compare__head">NOW</span><span></span><span class="mono restore-compare__head">AFTER RESTORE</span>
        <span class="mono restore-compare__label">CODE</span>
        <span class="mono"><%= @running&.short_sha || "—" %></span>
        <span class="restore-compare__arrow">→</span>
        <span class="mono restore-compare__after"><%= @snapshot.sha.to_s.first(7) %></span>
        <span class="mono restore-compare__label">DATA</span>
        <span>Live</span>
        <span class="restore-compare__arrow">→</span>
        <span class="restore-compare__after"><%= l(@snapshot.time, format: :short) %> · <%= @snapshot.kind %> · <%= @snapshot.bytes ? number_to_human_size(@snapshot.bytes) : "—" %> <small class="mono">(<%= @snapshot.short_id %>, <%= @location.name %>)</small></span>
      </div>

      <div class="restore-note">
        <span class="mono">NOTE</span>
        <span>
          <%= @project.name %> keeps serving while the snapshot is restored beside it; traffic switches only once the restored version passes its health check.
          Anything written after <%= l(@snapshot.time, format: :short) %> is replaced; a safety snapshot is taken just before the switch.
          <% if @project.maintenance? %>
            The maintenance page is up, so nothing is being written meanwhile.
          <% else %>
            The maintenance page is off: writes in the seconds before the switch would be lost. Put it up first (on the project page) if that matters.
          <% end %>
        </span>
      </div>

      <div class="restore__phases">
        <div class="restore__phase">
          <span class="mono restore__phase-title restore__phase-title--go">WHILE <%= @project.name.upcase %> KEEPS SERVING</span>
          <ol>
            <li>Fetch <span class="mono"><%= @snapshot.sha.to_s.first(7) %></span> from the repo (it must still be there), and its image from Houston's registry or a rebuild.</li>
            <li>Restore the snapshot's volumes and databases into new storage, beside the live data.</li>
          </ol>
        </div>
        <div class="restore__phase restore__phase--switch">
          <span class="mono restore__phase-title restore__phase-title--nogo">AT THE SWITCH</span>
          <ol start="3">
            <li>Start <span class="mono"><%= @snapshot.sha.to_s.first(7) %></span> on it, pass the health check, switch traffic, and remove the old storage.</li>
          </ol>
        </div>
      </div>

      <%= form_with url: project_restores_path(@project.name), class: "restore__confirm" do |f| %>
        <%= hidden_field_tag :snapshot, @snapshot.id %>
        <%= hidden_field_tag :location, @location.name %>
        <div class="field">
          <label for="confirm">Type <span class="mono"><%= @project.name %></span> to confirm</label>
          <%= text_field_tag :confirm, nil, id: "confirm", class: "mono", autocomplete: "off" %>
          <% if @error %><span class="field__error"><%= @error %></span><% end %>
        </div>
        <div class="restore__actions">
          <span class="mono muted">CLI: houston restore <%= @snapshot.short_id %> --confirm <%= @project.name %></span>
          <%= link_to "Cancel", project_path(@project.name), class: "button button--medium button--quiet" %>
          <%= f.submit "Restore #{@project.name}", class: "button button--primary button--medium" %>
        </div>
      <% end %>
    </div>
  </section>
</main>
