// Package sessions is the sign-in page (gantry's auth signs in and out).
package sessions

import (
	"github.com/scttymn/gantry/auth"

	"github.com/scttymn/houston/mission_control/app/shared/layout"
	"github.com/scttymn/houston/mission_control/assets"
)

templ New(p auth.Page, email string) {
	@layout.Layout(layout.Page{Title: "Sign in · Mission Control", NoHeader: true}) {
		<main class="signin">
			<form action={ templ.SafeURL(p.Paths.Login) } method="post" class="signin__form">
				<img src={ assets.Path("patch.svg") } width="320" height="296" alt="Houston Mission Control" class="signin__patch"/>
				<h1 class="disp">Sign in</h1>
				if p.Alert != "" {
					<div class="notice notice--nogo" role="alert">{ p.Alert }</div>
				}
				if p.Notice != "" {
					<div class="notice notice--go">{ p.Notice }</div>
				}
				<div class="field">
					<label for="email_address">Email</label>
					<input type="email" name="email_address" id="email_address" required autofocus autocomplete="username" value={ email }/>
				</div>
				<div class="field">
					<label for="password">Password</label>
					<input type="password" name="password" id="password" required autocomplete="current-password" maxlength="72"/>
				</div>
				<div><input type="submit" name="commit" value="Sign in" class="button button--primary"/></div>
			</form>
		</main>
	}
}
