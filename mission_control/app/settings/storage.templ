package settings

import (
	"strings"

	"github.com/scttymn/houston/mission_control/app/models"
	"github.com/scttymn/houston/mission_control/app/services/storage"
	"github.com/scttymn/houston/mission_control/app/shared/layout"
)

// Fields are the storage form's: first-run setup's and Settings'.
templ Fields(s storage.Setup, saved storage.Saved) {
	<fieldset class="kinds">
		<legend>Type</legend>
		for _, kind := range storage.Kinds {
			<label class="kinds__option mono"><input type="radio" value={ kind } checked?={ s.Kind == kind } name="storage[kind]" id={ "storage_kind_" + kind }/>{ kind }</label>
		}
	</fieldset>
	<div class="field">
		<label for="storage_name">Name</label>
		<input class="mono" placeholder="unas-nfs" required aria-invalid={ boolWord(nameProblem(saved) != "") } type="text" value={ s.Name } name="storage[name]" id="storage_name"/>
		if problem := nameProblem(saved); problem != "" {
			<span class="field__error">{ "Name " + problem + "." }</span>
		}
	</div>
	<div class="kind kind--nfs">
		@field("storage_nfs_server", "storage[nfs_server]", "NFS server", s.NFSServer, "10.0.1.20", "text", "")
		@field("storage_nfs_export", "storage[nfs_export]", "Export path", s.NFSExport, "/volume1/houston", "text", "Houston connects to it directly. Nothing to set up on this server.")
	</div>
	<div class="kind kind--local">
		@field("storage_local_path", "storage[local_path]", "Path on this server", s.LocalPath, "/srv/houston-backups", "text", "Fine for a second disk. A copy on the same disk as your apps won't survive that disk dying.")
	</div>
	<div class="kind kind--s3">
		@field("storage_s3_endpoint", "storage[s3_endpoint]", "Endpoint (optional)", s.S3Endpoint, "https://s3.amazonaws.com", "text", "")
		@field("storage_s3_bucket", "storage[s3_bucket]", "Bucket", s.S3Bucket, "", "text", "")
		<div class="field-pair">
			@field("storage_s3_access_key_id", "storage[s3_access_key_id]", "Access key ID", s.S3AccessKeyID, "", "text", "")
			@field("storage_s3_secret_access_key", "storage[s3_secret_access_key]", "Secret access key", "", "", "password", "")
		</div>
	</div>
	<div class="kind kind--b2">
		@field("storage_b2_bucket", "storage[b2_bucket]", "Bucket", s.B2Bucket, "", "text", "")
		<div class="field-pair">
			@field("storage_b2_key_id", "storage[b2_key_id]", "Key ID", s.B2KeyID, "", "text", "")
			@field("storage_b2_application_key", "storage[b2_application_key]", "Application key", "", "", "password", "")
		</div>
	</div>
	if details := otherProblems(saved); len(details) > 0 {
		<div class="checks" role="alert">
			for _, p := range details {
				<p class="check"><span class="mono check__state check__state--nogo">NO-GO</span><span>{ storage.Label(p.Field) + " " + p.Message + "." }</span></p>
			}
		</div>
	}
	if saved.Failed != "" {
		<div class="checks" role="alert">
			<p class="check"><span class="mono check__state check__state--nogo">NO-GO</span><span>{ saved.Failed }</span></p>
		</div>
	}
}

templ field(id, name, label, value, placeholder, kind, hint string) {
	<div class="field">
		<label for={ id }>{ label }</label>
		<input
			class="mono"
			if placeholder != "" {
				placeholder={ placeholder }
			}
			if kind == "password" || strings.Contains(id, "key") {
				autocomplete="off"
			}
			type={ kind }
			if value != "" {
				value={ value }
			}
			name={ name }
			id={ id }
		/>
		if hint != "" {
			<span class="field__hint">{ hint }</span>
		}
	</div>
}

templ NewStoragePage(page layout.Page, s storage.Setup, saved storage.Saved) {
	@layout.Layout(page) {
		<main class="settings">
			@nav("/settings")
			<div class="settings__body">
				<div class="board__title">
					<h1 class="disp">Add storage location</h1>
					<p>Houston writes a test repository there before saving it.</p>
				</div>
				<section class="panel">
					<form class="storage-form panel__row" action="/settings/storage" method="post">
						@Fields(s, saved)
						<div><input type="submit" name="commit" value="Test and save" class="button button--primary"/></div>
					</form>
				</section>
			</div>
		</main>
	}
}

// ShownOnce is a location's restic password, shown until the admin says
// it's saved: first-run setup's and Settings'.
templ ShownOnce(l models.StorageLocation, download, confirm, submit string, unsaved bool) {
	<section class="shown-once" aria-labelledby="password-title" data-controller="clipboard">
		<div class="mono shown-once__tag">SHOWN ONCE</div>
		<div class="shown-once__body">
			<h2 id="password-title" class="disp">Save this password now</h2>
			<p>Every backup on <span class="mono">{ l.Name }</span> is encrypted with this password. Mission Control keeps an encrypted copy, but if this server's disk dies, this is the only way to read your backups.</p>
			<div id="password" class="mono shown-once__password" data-clipboard-target="source">{ l.ResticPassword.Reveal() }</div>
			<div class="shown-once__actions">
				<button type="button" class="button" data-action="clipboard#copy" data-clipboard-target="button">Copy</button>
				<a class="button" data-turbo="false" href={ templ.SafeURL(download) }>Download .txt</a>
			</div>
			<form class="finish" action={ templ.SafeURL(confirm) } method="post">
				<label class="finish__saved"><input type="checkbox" name="saved" id="saved" value="1"/> I saved it somewhere off this server, like a password manager.</label>
				if unsaved {
					<span class="field__error" role="alert">Tick the box once the password is saved somewhere off this server.</span>
				}
				<div><input type="submit" name="commit" value={ submit } class="button button--primary"/></div>
			</form>
		</div>
	</section>
}

templ StoragePage(page layout.Page, l models.StorageLocation, unsaved bool) {
	@layout.Layout(page) {
		<main class="settings">
			@nav("/settings")
			<div class="settings__body">
				<div class="board__title">
					<h1 class="disp">{ l.Name }</h1>
					<p class="notice notice--go"><span class="mono">GO</span><span class="notice__text">Wrote a test file at <span class="mono">{ models.WhereItIs(l) }</span>. Backups are ready to go here once you've saved its password.</span></p>
				</div>
				@ShownOnce(l, "/settings/storage/"+l.Name+"/password.txt", "/settings/storage/"+l.Name+"/acknowledge", "Done", unsaved)
			</div>
		</main>
	}
}

func nameProblem(saved storage.Saved) string {
	var out []string
	for _, p := range saved.Problems {
		if p.Field == "name" {
			out = append(out, p.Message)
		}
	}
	return strings.Join(out, " and ")
}

func otherProblems(saved storage.Saved) []storage.Problem {
	var out []storage.Problem
	for _, p := range saved.Problems {
		if p.Field != "name" {
			out = append(out, p)
		}
	}
	return out
}

func boolWord(b bool) string {
	if b {
		return "true"
	}
	return "false"
}
