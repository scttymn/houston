package settings

import (
	"sort"
	"strings"
	"time"

	"github.com/scttymn/houston/mission_control/app/projects"
	"github.com/scttymn/houston/mission_control/app/services/cfsettings"
)

// routeRow is a tunnel rule in words: which name and path, and where it
// goes.
type routeRow struct {
	Hostname, Path, GoesTo, Service, State string
}

// routeRows are the tunnel's rules in words; mc is its address for Mission
// Control, to say which go to it.
func routeRows(v cfsettings.View, mc string) []routeRow {
	var seen []string
	var rows []routeRow
	add := func(r cfsettings.Route, state string) {
		host, path := "", ""
		if r.Hostname != nil {
			host = *r.Hostname
		}
		if r.Path != nil {
			path = *r.Path
		}
		row := routeRow{Hostname: host, State: state}
		switch {
		case path == "^/[a-z0-9-]+$":
			row.Path = "/<project>"
		case path != "":
			row.Path = path
		case contains(seen, host):
			row.Path = "anything else"
		default:
			row.Path = "any"
		}
		seen = append(seen, host)
		switch {
		case strings.HasPrefix(r.Service, "http_status:"):
			row.GoesTo = "Nothing (" + strings.TrimPrefix(r.Service, "http_status:") + ")"
		case r.Service == mc && path != "":
			row.GoesTo = "Webhooks"
		case r.Service == mc && strings.HasPrefix(host, "admin."):
			row.GoesTo = "Mission Control"
		case r.Service == mc:
			row.GoesTo = "Maintenance page"
		case r.Hostname == nil:
			row.GoesTo = "Your apps"
		default:
			row.GoesTo = r.Service
		}
		if !strings.HasPrefix(r.Service, "http_status:") {
			row.Service = r.Service
		}
		rows = append(rows, row)
	}
	for _, r := range v.Routes {
		state := ""
		if r.Drift {
			state = "drift"
		}
		add(r, state)
	}
	for _, r := range v.MissingRoutes {
		add(r, "missing")
	}
	return rows
}

func contains(list []string, s string) bool {
	for _, x := range list {
		if x == s {
			return true
		}
	}
	return false
}

// recordRows are Houston's records: its own names first, then each
// project's together.
func recordRows(v cfsettings.View) []cfsettings.Record {
	order := map[string]int{"admin": 0, "hooks": 1, "wildcard": 2}
	rank := func(p string) int {
		if n, ok := order[p]; ok {
			return n
		}
		return 3
	}
	rows := append([]cfsettings.Record(nil), v.Records...)
	sort.SliceStable(rows, func(i, j int) bool {
		a, b := rows[i], rows[j]
		if rank(a.Project) != rank(b.Project) {
			return rank(a.Project) < rank(b.Project)
		}
		if a.Project != b.Project {
			return a.Project < b.Project
		}
		return a.Name < b.Name
	})
	return rows
}

func recordFor(r cfsettings.Record) string {
	switch r.Project {
	case "admin":
		return "Mission Control"
	case "hooks":
		return "Webhooks"
	case "wildcard":
		return "Your apps (every name)"
	case "houston":
		return "Houston"
	}
	return r.Project
}

// Live is what Cloudflare has: the last answer, shown at once, and asked
// again in the background when it's old, or on Check now.
templ Live(v cfsettings.View, now time.Time, mc string) {
	{{ stale := v.Stale(now) }}
	<turbo-frame
		id="cloudflare-live"
		if stale {
			src="/settings/cloudflare"
			loading="lazy"
		}
	>
		<p class="cf-checked">
			<span>
				if v.CheckedAt.IsZero() {
					Checked just now
				} else {
					{ "Checked " + projects.Ago(v.CheckedAt, now) + " ago" }
				}
			</span>
			<a class="button button--small" data-turbo-frame="cloudflare-live" href="/settings/cloudflare">Check now</a>
		</p>
		if len(v.Problems) > 0 {
			<div class="notice notice--hold cf-problems">
				<span class="mono">HOLD</span>
				<span class="notice__text">{ "Cloudflare didn't answer everything: " + strings.Join(v.Problems, "; ") + "." + shownBefore(v) }</span>
			</div>
		}
		if t := v.Tunnel; t != nil {
			<div class="cf-block cf-tunnel" data-controller="clipboard">
				<span class="mono facts-strip__label">TUNNEL</span>
				<dl class="cf-facts">
					<dt>Name</dt><dd><span class="mono">{ t.Name }</span> <span class={ "mono state state--" + healthyState(t.Status) }>{ t.Status }</span></dd>
					<dt>Created</dt>
					<dd>
						if t.CreatedAt != nil {
							{ projects.ShortTime(t.CreatedAt.In(now.Location())) }
						} else {
							—
						}
					</dd>
					<dt>Tunnel ID</dt><dd><code class="mono" data-clipboard-target="source">{ t.ID }</code> <button type="button" class="button button--small" aria-label="Copy tunnel ID" data-action="clipboard#copy" data-clipboard-target="button">Copy</button></dd>
				</dl>
				<table class="cf-table cf-connections">
					<thead><tr><th>Data center</th><th>cloudflared</th><th>From</th><th>Connected</th></tr></thead>
					<tbody>
						for _, c := range v.Connections {
							<tr><td class="mono" data-label="Data center">{ c.Colo }</td><td class="mono" data-label="cloudflared">{ c.Version }</td><td class="mono" data-label="From">{ c.Origin }</td><td data-label="Connected">{ sinceWords(c.Since, now) }</td></tr>
						}
					</tbody>
				</table>
			</div>
		}
		if rows := routeRows(v, mc); len(rows) > 0 {
			<div class="cf-block">
				<span class="mono facts-strip__label">{ "ROUTES · WHERE THE TUNNEL SENDS EACH NAME" + driftWords(v) }</span>
				<table class="cf-table cf-routes">
					<thead><tr><th>Hostname</th><th>Path</th><th>Goes to</th></tr></thead>
					<tbody>
						for _, r := range rows {
							<tr>
								<td data-label="Hostname">
									if r.Hostname != "" {
										<span class="mono">{ r.Hostname }</span>
									} else {
										Every other name
									}
								</td>
								<td data-label="Path">
									if strings.HasPrefix(r.Path, "/") {
										<span class="mono">{ r.Path }</span>
									} else {
										{ r.Path }
									}
								</td>
								<td data-label="Goes to">
									<span>
										{ r.GoesTo }
										if r.Service != "" {
											<small class="mono muted">{ r.Service }</small>
										}
										if r.State != "" {
											<span class="mono state state--nogo">{ strings.ToUpper(r.State) }</span>
										}
									</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<div class="cf-block">
			<span class="mono facts-strip__label">HOUSTON'S DNS RECORDS · ONLY THESE, COMMENTED MANAGED-BY:HOUSTON</span>
			if len(v.Records) == 0 {
				<p class="muted">None found.</p>
			} else {
				<table class="cf-table cf-records">
					<thead><tr><th>Name</th><th>For</th><th>Points at</th><th>Proxy</th></tr></thead>
					<tbody>
						for _, r := range recordRows(v) {
							<tr><td class="mono" data-label="Name">{ r.Name }</td><td data-label="For">{ recordFor(r) }</td><td data-label="Points at" class={ templ.KV("muted", !r.Here) }>{ hereWords(r.Here) }</td><td data-label="Proxy">{ proxyWords(r.Proxied) }</td></tr>
						}
					</tbody>
				</table>
			}
		</div>
	</turbo-frame>
}

func shownBefore(v cfsettings.View) string {
	if v.Tunnel != nil || len(v.Records) > 0 {
		return " Showing what it said before."
	}
	return ""
}

func healthyState(status string) string {
	if status == "healthy" {
		return "go"
	}
	return "hold"
}

func sinceWords(t *time.Time, now time.Time) string {
	if t == nil {
		return "—"
	}
	return projects.Ago(*t, now) + " ago"
}

func driftWords(v cfsettings.View) string {
	if v.Drift {
		return " · DRIFT: REPAIR PUTS THEM BACK"
	}
	return ""
}

func hereWords(here bool) string {
	if here {
		return "this server"
	}
	return "another server"
}

func proxyWords(proxied bool) string {
	if proxied {
		return "proxied"
	}
	return "DNS only"
}
