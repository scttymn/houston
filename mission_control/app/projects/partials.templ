package projects

import (
	"strconv"
	"time"

	"github.com/scttymn/houston/mission_control/app/models"
	"github.com/scttymn/houston/mission_control/app/services/appstats"
)

// StatePill is a status as the design's pill: a dot and the word, on its
// colour.
templ StatePill(status string) {
	<span class={ "mono state state-pill state--" + Dasherize(status) }><span class="state-pill__dot"></span>{ StateLabel(status) }</span>
}

// Row is a project as the board shows it.
type Row struct {
	Project     models.Project
	Status      string // its latest deploy's, or standby
	Latest      *models.Deploy
	Running     *models.Deploy
	Backup      *models.BackupRun // its last good one
	FailedBackup, Deleting bool
	Hostnames   []string
	Stats       *appstats.Reading
}

// runningSha is what's serving, and what's next or what rule deploys.
templ runningSha(row Row) {
	<span class="mono">
		if row.Running != nil {
			{ row.Running.ShortSha() }
		} else {
			—
		}
	</span>
	switch {
		case row.Status == "in_flight" && row.Latest != nil:
			<small class="mono flight__next">{ "→ " + row.Latest.ShortSha() }</small>
		case row.Status == "no_go":
			<small class="">still serving</small>
		default:
			<small class="">{ ruleShort(row.Project) }</small>
	}
}

// domains are a project's hostnames, each with its DNS state.
templ domains(row Row) {
	for _, host := range row.Hostnames {
		{{ state := row.Project.DomainStates.V[host] }}
		<a target="_blank" rel="noopener noreferrer" class={ "flight__host host-chip--" + chipState(state.State) } href={ templ.SafeURL("https://" + host) }>
			<span class="flight__dot"></span><span class="flight__hostname">{ host }</span>
			if state.State != "" && state.State != "DNS OK" {
				<small class={ "mono domain-state domain-state--" + Parameterize(state.State) } title={ state.Reason }>{ state.State }</small>
			}
			<svg width="11" height="11" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M4.5 2H10v5.5M10 2L2.5 9.5" stroke="currentColor" stroke-width="1.4"></path></svg><span class="visually-hidden">(opens in a new window)</span>
		</a>
	}
}

// lastDeploy is a project's latest deploy, in words.
templ lastDeploy(row Row, now time.Time) {
	if d := row.Latest; d == nil {
		<span>Never deployed</span><small>Deploy on its page, or run houston deploy</small>
	} else {
		{{ href := templ.SafeURL("/projects/" + row.Project.Name + "/deploys/" + strconv.FormatInt(d.Number, 10)) }}
		switch d.Status {
			case "in_flight":
				<a class="flight__deploying" href={ href }>{ "Deploying · " + MissionElapsed(d.Duration(now)) }</a>
				<small>
					if d.Step != "" {
						{ d.Step }
					} else {
						starting
					}
				</small>
			case "no_go":
				<a class="flight__failed" href={ href }>{ "Failed " + Ago(finished(d), now) + " ago" }</a>
				<small>{ d.ShortSha() + " · " + d.Error }</small>
			case "queued":
				<a href={ href }>Queued</a>
				<small>{ d.ShortSha() }</small>
			default:
				<a class="flight__plain" href={ href }>{ Ago(finished(d), now) + " ago · " + DurationWords(d.Duration(now)) }</a>
				<small>{ RefName(d.Ref) }</small>
		}
	}
}

// lastBackup is a project's last good backup.
templ lastBackup(b *models.BackupRun, zone *time.Location) {
	if b != nil {
		<span>{ ShortTime(b.FinishedAt.Time.In(zone)) }</span>
		<small>{ backupWords(*b) }</small>
	} else {
		<span class="muted">—</span>
	}
}

// Resources are an app's CPU, memory and disk, read while the board is
// open: tick gauges against each limit, or the host's without one.
templ Resources(stats *appstats.Reading, now time.Time) {
	if s := stats; s != nil {
		{{ cpu, cpuOK := s.CPUPercent() }}
		{{ memory, memoryOK := s.MemoryPercent() }}
		{{ disk, diskOK := s.DiskPercent() }}
		@usage("cpu", "CPU", CoresWords(s.CPUCores), wholeWords(s.CPUWhole(), CoresWords), cpu, cpuOK, s.CPUOfHost())
		@usage("memory", "MEM", SizeWords(s.MemoryBytes), wholeWords(s.MemoryWhole(), sizeOf), memory, memoryOK, s.MemoryOfHost())
		@usage("disk", "DISK", SizeWords(s.DiskBytes), wholeWords(s.DiskWhole(), sizeOf), disk, diskOK, true)
		if s.Stale(now) {
			<small class="usage__stale">{ "stale: read " + Ago(s.SampledAt, now) + " ago" }</small>
		}
	} else {
		<span class="muted">—</span>
	}
}

// usage is one figure: its label, ten ticks lit up to the share used, the
// percentage, and the amount used.
templ usage(kind, label, amount, limit string, percent float64, ok, ofHost bool) {
	<span class={ "usage", "usage--" + kind, templ.KV("usage--near", ok && percent >= near) } title={ UsageTitle(label, amount, limit, percent, ok, ofHost) }>
		<span class="mono usage__label">{ label }</span>
		@gauge(percent, ok)
		<span class="mono usage__percent">{ PercentWords(percent, ok) }</span>
		<span class="usage__amount">{ amount }</span>
	</span>
}

templ gauge(percent float64, ok bool) {
	{{ on := Ticks(percent, ok) }}
	{{ label := "no limit" }}
	if ok {
		{{ label = PercentWords(percent, ok) }}
	}
	<span class={ "gauge", templ.KV("gauge--open", !ok) } role="img" aria-label={ label }>
		for i := range 10 {
			<span class={ "gauge__tick", templ.KV("is-on", i < on) }></span>
		}
	</span>
}

templ launchPad() {
	<svg width="132" height="96" viewBox="0 0 140 100" fill="none" role="img" aria-label="An empty launch pad"><line x1="4" y1="92" x2="136" y2="92" stroke="#1A1D24" stroke-width="1.5"></line><rect x="30" y="80" width="80" height="12" stroke="#1A1D24" stroke-width="1.5"></rect><rect x="60" y="80" width="20" height="12" fill="#1A1D24"></rect><line x1="38" y1="80" x2="38" y2="16" stroke="#1A1D24" stroke-width="1.5"></line><line x1="50" y1="80" x2="50" y2="16" stroke="#1A1D24" stroke-width="1.5"></line><polyline points="38,80 50,72 38,64 50,56 38,48 50,40 38,32 50,24 38,16" stroke="#1A1D24" stroke-width="1"></polyline><line x1="35" y1="16" x2="53" y2="16" stroke="#1A1D24" stroke-width="1.5"></line><circle cx="44" cy="11" r="2.6" fill="#C8321F"></circle><line x1="50" y1="32" x2="62" y2="32" stroke="#1A1D24" stroke-width="1.5"></line><line x1="62" y1="29" x2="62" y2="35" stroke="#1A1D24" stroke-width="1.5"></line><line x1="50" y1="56" x2="62" y2="56" stroke="#1A1D24" stroke-width="1.5"></line><line x1="62" y1="53" x2="62" y2="59" stroke="#1A1D24" stroke-width="1.5"></line><path d="M64 80 V38 L70 22 L76 38 V80" stroke="#8C909A" stroke-width="1.2" stroke-dasharray="3 3"></path></svg>
}
