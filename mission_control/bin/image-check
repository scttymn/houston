#!/usr/bin/env bash
# The production image, run as the installer runs it: it serves on port 80
# as uid 1000 (cloudflared's), first run's code and page work, and it's
# its own tools image (sh, mkdir, git, ssh, docker, and /app
# backup-sqlite). Build it first, from the module's root:
#
#   docker build -f mission_control/Dockerfile --target production -t houston/mission-control:local .
set -euo pipefail
image=${1:-houston/mission-control:local}
name=mc-image-check-$$
out=$(mktemp -d)
cleanup() {
	docker rm -f "$name" >/dev/null 2>&1 || true
	docker volume rm "$name-data" "$name-app" >/dev/null 2>&1 || true
	rm -rf "$out"
}
trap cleanup EXIT
fail() { echo "FAIL $*"; exit 1; }
ok() { echo "ok   $*"; }

docker run -d --name "$name" -p 127.0.0.1::80 -v "$name-data:/data" -e ENCRYPTION_KEYS="$(head -c 32 /dev/urandom | base64)" \
	-e SECRET_KEY_BASE=image-check -e HOUSTON_RUNNER_TOKEN=image-check-runner-token-0123456789abcdef "$image" >/dev/null
port=$(docker port "$name" 80/tcp | head -1 | sed 's/.*://')
for i in $(seq 60); do
	curl -sf -o /dev/null "http://127.0.0.1:$port/up" && break
	[ "$i" -lt 60 ] || { docker logs "$name"; fail "no /up on port 80"; }
	sleep 1
done
ok "/up on port 80"

[ "$(docker exec "$name" id -u)" = 1000 ] || fail "runs as $(docker exec "$name" id -u), not 1000"
ok "runs as 1000"

code=$(docker exec "$name" /app task setup-code)
[[ $code =~ ^[A-HJ-NP-Z2-9]{4}-[A-HJ-NP-Z2-9]{4}$ ]] || fail "setup code $code"
curl -sf "http://127.0.0.1:$port/setup" | grep -q "Create the admin login" || fail "no setup page"
ok "setup code and page"

docker run --rm --entrypoint sh "$image" -c 'git --version && ssh -V 2>&1 && docker --version && mkdir -p /tmp/x' >/dev/null ||
	fail "a tool missing"
ok "its tools: sh, mkdir, git, ssh, docker"

docker run --rm --user 0 -v "$name-app:/data/app" --entrypoint sqlite3 "$image" /data/app/app.db \
	"CREATE TABLE t (x); INSERT INTO t VALUES (1);"
report=$(docker run --rm --user 0 -v "$name-app:/data/app" -v "$out:/out" --entrypoint /app "$image" backup-sqlite /data /out)
grep -q '"path":"app.db"' <<<"$report" && [ -n "$(ls "$out/sqlite")" ] || fail "backup-sqlite: $report"
ok "backup-sqlite"
