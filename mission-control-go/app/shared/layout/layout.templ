// Package layout is the page shell every page is drawn in: the head, and
// the top bar (Rails' layouts/application and shared/_header).
package layout

import "github.com/scttymn/houston/mission-control-go/assets"

templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<title>{ p.title() }</title>
			<meta name="viewport" content="width=device-width,initial-scale=1"/>
			<meta name="application-name" content="Mission Control"/>
			// Fingerprinted: Cloudflare caches them for a year, so a changed icon gets a new URL.
			<link rel="icon" href={ assets.Path("icon.png") } type="image/png"/>
			<link rel="icon" href={ assets.Path("icon.svg") } type="image/svg+xml"/>
			@assets.Styles.Tag()
			@assets.ImportMap.Tag()
			if p.Head != nil {
				@p.Head
			}
		</head>
		<body>
			if !p.NoHeader {
				@header(p.Chrome)
			}
			{ children... }
			if p.Toast != nil {
				@toast(*p.Toast)
			}
		</body>
	</html>
}

// brand is the lunar module from the patch, in cream for the dark bar.
templ brand() {
	<a href="/" class="brand">
		<img src={ assets.Path("lander.svg") } width="40" height="40" alt="" class="brand__mark"/>
		<span class="brand__name"><span class="disp">HOUSTON</span><span class="mono">MISSION CONTROL</span></span>
	</a>
}

templ statusWord(ok bool) {
	if ok {
		<span class="status__go">GO</span>
	} else {
		<span class="status__nogo">NO-GO</span>
	}
}

// strip is the systems' status under the bar on a phone.
templ strip(s *Status) {
	<div class="mono topbar__strip">
		<span>
			{ "TUNNEL " }
			@statusWord(s.Tunnel)
		</span>
		<span>
			{ "REGISTRY " }
			@statusWord(s.Registry)
		</span>
		<span class="topbar__spacer"></span>
		<span class="status__clock">{ s.Clock }</span>
	</div>
}

templ chevron() {
	<svg width="10" height="16" viewBox="0 0 10 16" fill="none" aria-hidden="true"><path d="M2 2l6 6-6 6" stroke="currentColor" stroke-width="1.6"></path></svg>
}

templ signOut(class string) {
	<form class="button_to" method="post" action="/session">
		<input type="hidden" name="_method" value="delete" autocomplete="off"/>
		<button class={ class } type="submit">Sign out</button>
	</form>
}

// header is the top bar. On a phone: the brand, a menu button, and a
// status strip under it; the menu holds the nav, the systems and Sign out.
templ header(c Chrome) {
	<div class="topbar-shell" data-controller="menu" data-action="keydown.esc@window->menu#close">
		<header class="topbar">
			@brand()
			if c.SignedIn {
				<nav class="topbar__nav">
					<a href="/" class={ templ.KV("is-current", !c.Settings) }>Projects</a>
					<a href="/settings" class={ templ.KV("is-current", c.Settings) }>Settings</a>
				</nav>
				<span class="topbar__spacer"></span>
				if c.Status != nil {
					<div class="mono status">
						<span>
							{ "TUNNEL " }
							@statusWord(c.Status.Tunnel)
						</span>
						if c.Status.Expected > 0 {
							<span>
								{ "RUNNERS " + c.Status.runners() + " " }
								@statusWord(c.Status.Runners >= c.Status.Expected)
							</span>
						}
						<span>
							{ "REGISTRY " }
							@statusWord(c.Status.Registry)
						</span>
						<span class="status__clock">{ c.Status.Clock }</span>
					</div>
				}
				@signOut("topbar__signout")
				<button type="button" class="topbar__menu" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu" data-menu-target="button" data-action="menu#open">
					<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M3 6h16M3 11h16M3 16h16" stroke="currentColor" stroke-width="1.8"></path></svg>
				</button>
				if c.Status != nil {
					@strip(c.Status)
				}
			}
		</header>
		if c.SignedIn {
			<div id="mobile-menu" class="mobile-menu" hidden data-menu-target="panel">
				<div class="mobile-menu__bar">
					@brand()
					<span class="topbar__spacer"></span>
					<button type="button" class="topbar__menu" aria-label="Close menu" data-menu-target="close" data-action="menu#close">
						<svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true"><path d="M5 5l12 12M17 5L5 17" stroke="currentColor" stroke-width="1.8"></path></svg>
					</button>
				</div>
				if c.Status != nil {
					@strip(c.Status)
				}
				<nav class="mobile-menu__nav" aria-label="Main">
					<a href="/" class={ templ.KV("is-current", !c.Settings) }>
						Projects
						@chevron()
					</a>
					<a href="/settings" class={ templ.KV("is-current", c.Settings) }>
						Settings
						@chevron()
					</a>
				</nav>
				if c.Status != nil {
					<div class="mobile-menu__systems">
						<span class="mono mobile-menu__label">SYSTEMS</span>
						<div>
							<span>Tunnel</span>
							<span class="mono">
								@statusWord(c.Status.Tunnel)
							</span>
						</div>
						<div>
							<span>Registry</span>
							<span class="mono">
								@statusWord(c.Status.Registry)
							</span>
						</div>
						<div><span>Version</span><span class="mono">{ c.Version }</span></div>
					</div>
				}
				<div class="mobile-menu__foot">
					@signOut("mobile-menu__signout")
				</div>
			</div>
		}
	</div>
}

// toast is what just happened, in a corner, gone after a few seconds.
templ toast(t Toast) {
	<div class={ "toast", templ.KV("toast--nogo", t.NoGo), templ.KV("toast--go", !t.NoGo) } role="status" data-controller="toast" data-action="click->toast#dismiss">{ t.Text }</div>
}

// MorphRefreshes has a live refresh morph the page in place, keeping the
// scroll (Rails' turbo_refreshes_with method: :morph, scroll: :preserve).
templ MorphRefreshes() {
	<meta name="turbo-refresh-method" content="morph"/>
	<meta name="turbo-refresh-scroll" content="preserve"/>
}
