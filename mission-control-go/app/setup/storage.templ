package setup

import (
	"github.com/scttymn/houston/mission-control-go/app/models"
	"github.com/scttymn/houston/mission-control-go/app/services/storage"
	"github.com/scttymn/houston/mission-control-go/app/settings"
	"github.com/scttymn/houston/mission-control-go/app/shared/layout"
)

// StoragePage is step 3: the storage form, then the location made (l) and
// its password to save.
templ StoragePage(page layout.Page, l *models.StorageLocation, form storage.Setup, saved storage.Saved, unsaved bool) {
	@layout.Layout(page) {
		<main class="setup">
			<div class="setup__form">
				<div class="setup__intro">
					<span class="mono eyebrow eyebrow--signal">STEP 03 OF 03</span>
					<h1 class="disp">Default backup storage</h1>
					<p>Snapshots go here unless a project picks another location on its project page.</p>
				</div>
				if l != nil {
					<dl class="facts">
						<dt class="mono">NAME</dt><dd class="mono">{ l.Name }</dd>
						<dt class="mono">TYPE</dt><dd class="mono">{ l.Kind }</dd>
						<dt class="mono">WHERE</dt><dd class="mono">{ models.WhereItIs(*l) }</dd>
					</dl>
					<p class="check notice notice--go"><span class="mono check__state">GO</span><span>Wrote a test file. Backups are ready to go here.</span></p>
				} else {
					<form class="storage-form" action="/setup/storage" accept-charset="UTF-8" method="post">
						@settings.Fields(form, saved)
						<div><input type="submit" name="commit" value="Test and save" class="button button--primary"/></div>
					</form>
				}
			</div>
			if l != nil {
				@settings.ShownOnce(*l, "/setup/storage/password.txt", "/setup/storage/finish", "Finish setup", unsaved)
			}
		</main>
	}
}
